# Maintainer: LIghtJUNction

pkgname=lmm-api-bin
pkgver=0.1.2
pkgrel=1
pkgdesc='LMM API shared launcher, service, configuration, and web frontend (prebuilt)'
arch=('any')
url='https://github.com/LIghtJUNction/api.lmm.best'
license=('AGPL-3.0-only')
depends=('bash' 'ca-certificates' 'coreutils' 'sed' 'systemd' 'tzdata')
makedepends=('cosign')
optdepends=(
  'lmm-api-go: Go backend provider'
  'lmm-api-rs: Rust backend provider'
)
provides=("lmm-api=${pkgver}")
conflicts=('lmm-api' 'lmm-api-git' 'new-api' 'new-api-bin' 'new-api-git')
replaces=('new-api-bin')
backup=('etc/lmm-api/backend.conf' 'etc/lmm-api/lmm-api.env')
install=lmm-api-bin.install
options=('!strip')

_release_tag="v${pkgver}"
_artifact="lmm-api-core-${pkgver}"
_release_base="${url}/releases/download/${_release_tag}"
source=(
  "${_artifact}.tar.gz::${_release_base}/${_artifact}.tar.gz"
  "${_artifact}.tar.gz.sha256::${_release_base}/${_artifact}.tar.gz.sha256"
  "${_artifact}.tar.gz.sigstore.json::${_release_base}/${_artifact}.tar.gz.sigstore.json"
)
noextract=("${_artifact}.tar.gz")
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  local archive="${_artifact}.tar.gz"
  local expected actual

  expected=$(awk 'NR == 1 { print $1 }' "${archive}.sha256")
  [[ ${expected} =~ ^[[:xdigit:]]{64}$ ]] || return 1
  actual=$(sha256sum "${archive}")
  [[ ${actual%% *} == "${expected}" ]] || return 1
  cosign verify-blob \
    --bundle "${archive}.sigstore.json" \
    --certificate-identity \
      "${url}/.github/workflows/release.yml@refs/tags/${_release_tag}" \
    --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \
    "${archive}"
  bsdtar -xf "${archive}"
}

package() {
  local bundle="${srcdir}/${_artifact}"

  install -Dm0755 "${bundle}/lmm-api-launcher" "${pkgdir}/usr/bin/lmm-api"
  install -Dm0755 "${bundle}/lmm-api-select" "${pkgdir}/usr/bin/lmm-api-select"
  install -Dm0644 "${bundle}/lmm-api.service" \
    "${pkgdir}/usr/lib/systemd/system/lmm-api.service"
  install -Dm0644 "${bundle}/backend.conf" "${pkgdir}/etc/lmm-api/backend.conf"
  install -Dm0600 "${bundle}/lmm-api.env" "${pkgdir}/etc/lmm-api/lmm-api.env"
  install -Dm0644 "${bundle}/lmm-api-rs.env.example" \
    "${pkgdir}/usr/share/doc/${pkgname}/lmm-api-rs.env.example"
  install -d -m0755 "${pkgdir}/usr/share/lmm-api/frontend-dist"
  cp -R --no-preserve=ownership,mode,timestamps -- "${bundle}/frontend-dist/." \
    "${pkgdir}/usr/share/lmm-api/frontend-dist/"
  find "${pkgdir}/usr/share/lmm-api/frontend-dist" -type d -exec chmod 0755 {} +
  find "${pkgdir}/usr/share/lmm-api/frontend-dist" -type f -exec chmod 0644 {} +
  for file in LICENSE NOTICE THIRD-PARTY-LICENSES.md; do
    install -Dm0644 "${bundle}/${file}" "${pkgdir}/usr/share/licenses/${pkgname}/${file}"
  done
  install -Dm0644 "${bundle}/REVISION" "${pkgdir}/usr/share/doc/${pkgname}/REVISION"
}
