pkgbase = lmm-api-bin
	pkgdesc = LMM API model management and distribution system (prebuilt binary)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/LIghtJUNction/api.lmm.best
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	makedepends = cosign
	depends = ca-certificates
	depends = tzdata
	provides = lmm-api=0.1.0
	provides = new-api=0.1.0
	conflicts = lmm-api
	conflicts = lmm-api-git
	conflicts = new-api
	conflicts = new-api-bin
	conflicts = new-api-git
	noextract = lmm-api-go-0.1.0-linux-amd64.tar.gz
	noextract = lmm-api-go-0.1.0-linux-arm64.tar.gz
	options = !strip
	backup = etc/lmm-api/lmm-api.env
	source_x86_64 = lmm-api-go-0.1.0-linux-amd64.tar.gz::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-amd64.tar.gz
