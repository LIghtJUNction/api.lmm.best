# Maintainer: LMM API maintainers
#
# This is a local, fallback.lmm.best-only -bin package.  The companion
# build-local-package.sh supplies locally built binaries and the explicitly
# selected test assets below; this PKGBUILD never downloads or deploys code.

pkgname=lmm-api-rs-fallback-bin
pkgver="${LMM_API_RS_PKGVER:-0.1.0}"
pkgrel="${LMM_API_RS_PKGREL:-1}"
pkgdesc='Prebuilt LMM API Rust fallback test instance with auditable inputs'
arch=('x86_64')
url='https://github.com/LIghtJUNction/api.lmm.best'
license=('AGPL-3.0-or-later')
depends=('bash' 'coreutils' 'gcc-libs' 'glibc' 'jq' 'systemd' 'util-linux')
optdepends=(
  'nginx: optional fallback.lmm.best reverse proxy'
  'postgresql: database used by the isolated test instance'
  'valkey: cache and rate-limit service used by the isolated test instance'
)
install=lmm-api-rs-fallback-bin.install
source=(
  'lmm-api-rs'
  'lmm-db-migrate'
  'revision.txt'
  'payload.sha256'
  'source-manifest.tsv'
  'source-manifest.sha256'
  'selected-fallback-assets.tar'
  'lmm-api-rs-fallback-bin.install'
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

prepare() {
  # The archive is a transport for the explicitly selected files only.  It is
  # not installed and is never treated as a deploy-tree mirror.
  tar -xf "$srcdir/selected-fallback-assets.tar" -C "$srcdir"
}

package() {
  local deploy_root="$pkgdir/usr/lib/lmm-api-rs/deploy"
  local migration_root="$pkgdir/usr/share/lmm-api-rs/migration"

  install -Dm0755 "$srcdir/lmm-api-rs" \
    "$pkgdir/usr/lib/lmm-api-rs/bin/lmm-api-rs"
  install -Dm0755 "$srcdir/lmm-db-migrate" \
    "$pkgdir/usr/lib/lmm-api-rs/bin/lmm-db-migrate"
  install -Dm0644 "$srcdir/revision.txt" \
    "$pkgdir/usr/share/lmm-api-rs/revision"
  install -Dm0644 "$srcdir/payload.sha256" \
    "$pkgdir/usr/share/lmm-api-rs/payload.sha256"
  install -Dm0644 "$srcdir/source-manifest.tsv" \
    "$pkgdir/usr/share/lmm-api-rs/source-manifest.tsv"
  install -Dm0644 "$srcdir/source-manifest.sha256" \
    "$pkgdir/usr/share/lmm-api-rs/source-manifest.sha256"
  (
    cd "$pkgdir"
    sha256sum --check --strict usr/share/lmm-api-rs/payload.sha256
    expected=$(<usr/share/lmm-api-rs/source-manifest.sha256)
    actual=$(sha256sum usr/share/lmm-api-rs/source-manifest.tsv | awk '{print $1}')
    [[ $expected == "$actual" ]]
  )

  # Only the single-instance fallback deployment entry points are packaged.
  install -Dm0755 \
    "$srcdir/deploy/backend-rust/deploy-lmm-api-rs-single-instance.sh" \
    "$deploy_root/deploy-lmm-api-rs-single-instance.sh"
  install -Dm0755 \
    "$srcdir/deploy/backend-rust/install-lmm-api-rs-single-instance.sh" \
    "$deploy_root/install-lmm-api-rs-single-instance.sh"
  install -Dm0755 \
    "$srcdir/deploy/backend-rust/fallback-target-guard.sh" \
    "$deploy_root/fallback-target-guard.sh"
  install -Dm0755 \
    "$srcdir/deploy/backend-rust/generate-release-metadata.sh" \
    "$deploy_root/generate-release-metadata.sh"
  install -Dm0644 \
    "$srcdir/deploy/backend-rust/lmm-api-rs-single.service" \
    "$pkgdir/usr/lib/systemd/system/lmm-api-rs-single.service"
  install -Dm0644 \
    "$srcdir/deploy/backend-rust/single.env" \
    "$deploy_root/single.env"
  install -Dm0644 \
    "$srcdir/deploy/backend-rust/test-instance.env.example" \
    "$deploy_root/test-instance.env.example"
  install -Dm0644 \
    "$srcdir/deploy/backend-rust/nginx/fallback.lmm.best.conf" \
    "$deploy_root/fallback.lmm.best.conf"

  # These four files are deliberately installed directly at the deploy root;
  # no hidden deploy-tree mirror can silently widen the package surface.
  install -Dm0755 \
    "$srcdir/deploy/backend-rust/create-sanitized-test-schema.sh" \
    "$deploy_root/create-sanitized-test-schema.sh"
  install -Dm0755 \
    "$srcdir/deploy/backend-rust/import-sanitized-auth-snapshot.sh" \
    "$deploy_root/import-sanitized-auth-snapshot.sh"
  install -Dm0644 \
    "$srcdir/deploy/backend-rust/sanitized-auth-snapshot-v1.tsv.schema" \
    "$deploy_root/sanitized-auth-snapshot-v1.tsv.schema"
  install -Dm0644 \
    "$srcdir/deploy/backend-rust/README-sanitized-test-schema.md" \
    "$deploy_root/README-sanitized-test-schema.md"

  # Immutable migration inputs used by the packaged test-only rehearsal.
  install -Dm0644 \
    "$srcdir/apps/api-rust/crates/lmm-db-migrate/schema/table-map.json" \
    "$migration_root/table-map.json"
  install -Dm0644 \
    "$srcdir/apps/api-rust/crates/lmm-db-migrate/schema/postgresql-baseline.sql" \
    "$migration_root/postgresql-baseline.sql"
  install -Dm0644 \
    "$srcdir/apps/api-rust/crates/lmm-db-migrate/schema/export-postgres-catalog.sql" \
    "$migration_root/export-postgres-catalog.sql"
  install -Dm0644 \
    "$srcdir/apps/api-rust/migrations/0001_schema_contract.sql" \
    "$migration_root/0001_schema_contract.sql"
  install -Dm0644 \
    "$srcdir/apps/api-rust/tests/fixtures/routes/legacy-go-routes.tsv" \
    "$migration_root/legacy-go-routes.tsv"

  install -d -m0755 "$pkgdir/usr/lib/sysusers.d"
  cat >"$pkgdir/usr/lib/sysusers.d/lmm-api-rs-fallback.conf" <<'EOF'
u lmm-api-rs-fallback - "LMM API Rust fallback test instance" /var/lib/lmm-api-rs-single /usr/bin/nologin
EOF
}
