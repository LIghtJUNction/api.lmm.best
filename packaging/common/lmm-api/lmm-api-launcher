env_file=/etc/lmm-api/lmm-api.env
parse_database_url() {
  local line value database_url='' assignments=0
  [[ -f $env_file && ! -L $env_file ]] || exit 2
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    # shellcheck disable=SC2016 # Reject literal command-substitution syntax.
    [[ $line != *'$('* && $line != *'`'* ]] || exit 2
    [[ $line =~ ^[[:space:]]*(SQL_DSN|DATABASE_URL)[[:space:]]*=(.*)$ ]] || continue
    ((assignments += 1)); value=${BASH_REMATCH[2]}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    if [[ $value == \'*\' && ${#value} -ge 2 ]]; then
      value=${value:1:${#value}-2}; [[ $value != *\'* ]] || exit 2
    elif [[ $value == \"*\" && ${#value} -ge 2 ]]; then
      value=${value:1:${#value}-2}
      [[ $value != *\\* && $value != *'$'* && $value != *\"* ]] || exit 2
    fi
    [[ $value == postgres://* || $value == postgresql://* ]] || exit 2
    [[ $value != *[[:space:]]* && $value != *'('* && $value != *')'* ]] || exit 2
    [[ $value != *'{'* && $value != *'}'* && $value != *';'* ]] || exit 2
    database_url=$value
  done <"$env_file"
  ((assignments == 1)) || exit 2
  printf '%s' "$database_url"
}

frontend_link=$(readlink -- /srv/lmm-api-frontend/current)
[[ $frontend_link =~ ^releases/([A-Za-z0-9][A-Za-z0-9._-]{0,127})$ ]] || exit 2
