  remote_status=$("${ssh_cmd[@]}" cat -- "$(remote_transaction_root)/staging/status")
  [[ $remote_status == ROLLED_BACK\ * ]] || die 'target did not verify a durable frontend rollback result'
}

execute_remote_switch() {
  if (( FRONTEND_ONLY )); then
    execute_remote_frontend_switch
    return
  fi
  local activator frontend_script core_sha backend_sha remote_transaction remote_root route_sha status revision acceptance_file
  local -a ssh_cmd scp_cmd
  ((EXECUTE_REMOTE == 1)) || return 0
  [[ $BACKEND == rs ]] || die 'remote switch transaction is implemented only for the Rust production target'
  [[ -n $JUMP_HOST ]] || die 'production remote switch requires --jump-host archczy'
  [[ -n ${LMM_ACCEPTANCE_CREDENTIAL_FILE:-} && -z ${LMM_ACCEPTANCE_CREDENTIAL_FD:-} ]] || \
    die 'remote acceptance requires LMM_ACCEPTANCE_CREDENTIAL_FILE; inherited credential FDs cannot cross SSH'
  acceptance_file=$LMM_ACCEPTANCE_CREDENTIAL_FILE
  is_safe_remote_credential_path "$acceptance_file" || \
    die 'remote acceptance credential file path is unsafe'
  validate_ssh_transport
  activator="$transaction_dir/activate-rust-release.sh"
  frontend_script="$transaction_dir/frontend-release.sh"
  [[ -x $activator && ! -L $activator && -x $frontend_script && ! -L $frontend_script ]] || \
    die 'embedded target runtime is unavailable'
  [[ -f $transaction_dir/core.pkg && -f $transaction_dir/backend.pkg ]] || die 'staged packages are missing'
  core_sha=$(sha256sum "$transaction_dir/core.pkg" | awk '{print $1}')
  backend_sha=$(sha256sum "$transaction_dir/backend.pkg" | awk '{print $1}')
  revision=$(resolve_revision)
  remote_transaction=$(remote_transaction_root)
  remote_root="$remote_transaction/staging"
  status="$remote_root/status"
  ssh_cmd=(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  scp_cmd=(scp -F "$SSH_CONFIG" -o "ProxyJump=$JUMP_HOST" -P "$PRODUCTION_SSH_PORT")

  "${ssh_cmd[@]}" install -d -m0700 "$remote_root"
  "${ssh_cmd[@]}" bash -s -- "$transaction_id" "$(encode_remote_value "$remote_transaction")" <<'EOF'
set -Eeuo pipefail
deployment_id=$1
decode() { printf '%s' "$1" | base64 --decode; }
workspace=$(decode "$2")
install -d -m0700 "$workspace" "$workspace/staging"
printf 'format=1\ndeployment_id=%s\nrole=target\nworkspace=%s\ncreated_at_utc=%s\n' \
  "$deployment_id" "$workspace" "$(date -u +%FT%TZ)" >"$workspace/.lmm-deploy-workspace"
chmod 0600 "$workspace/.lmm-deploy-workspace"
EOF
  "${scp_cmd[@]}" "$transaction_dir/core.pkg" "$transaction_dir/backend.pkg" \
    "$transaction_dir/lmm-api-rollback.service" "$transaction_dir/lmm-api-rollback.timer" \
    "$activator" "$frontend_script" "$ROUTE_GATE" "$PRODUCTION_SSH_TARGET:$remote_root/"
  route_sha=$(sha256sum "$ROUTE_GATE" | awk '{print $1}')
  remote_run_activator prepare "$acceptance_file" \
    "${TARGET_BACKUP:-/var/lib/lmm-api/deploy-backups/$transaction_id}" \
    "$core_sha" "$backend_sha" "$revision" "$route_sha"
  remote_run_activator switch "$acceptance_file" \
    "${TARGET_BACKUP:-/var/lib/lmm-api/deploy-backups/$transaction_id}" \
    "$core_sha" "$backend_sha" "$revision" "$route_sha"
  remote_status=$("${ssh_cmd[@]}" cat -- "$status")
  [[ $remote_status == AWAITING_CONFIRMATION\ * ]] || die "target activation did not await confirmation: $remote_status"
}

remote_rollback() {
  if (( FRONTEND_ONLY )); then
    remote_frontend_rollback
    return
  fi
  local remote_status
  local -a ssh_cmd
  ((EXECUTE_REMOTE == 1)) || die 'rollback requires --execute-remote'
