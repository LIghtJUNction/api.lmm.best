  "${target_scp[@]}" -r "$PRODUCTION_SSH_TARGET:$remote_controller/." "$CONTROLLER_BACKUP/"
  "${target_scp[@]}" -r "$PRODUCTION_SSH_TARGET:$remote_offhost/." "$offhost_mirror/"
  chmod -R u=rwX,go= "$CONTROLLER_BACKUP" "$offhost_mirror"
  verify_backup_copy controller "$CONTROLLER_BACKUP"
  verify_backup_copy off-host "$offhost_mirror"
  if find "$CONTROLLER_BACKUP" "$offhost_mirror" -type f \
