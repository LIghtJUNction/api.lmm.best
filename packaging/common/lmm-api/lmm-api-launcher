#!/usr/bin/env bash
set -Eeuo pipefail

readonly BACKEND_ROOT=${LMM_API_BACKEND_ROOT:-/usr/lib/lmm-api/backends}
readonly GO_BINARY="$BACKEND_ROOT/go/lmm-api"
readonly RS_BINARY="$BACKEND_ROOT/rs/lmm-api-rs"

die() {
  printf 'lmm-api: %s\n' "$*" >&2
  exit 78
}

backend=${LMM_API_BACKEND:-auto}
case $backend in
  auto)
    if [[ -x $GO_BINARY ]]; then
      backend=go
    elif [[ -x $RS_BINARY ]]; then
      backend=rs
    else
      die 'no backend is installed; install lmm-api-go-bin, lmm-api-go-git, lmm-api-rs-bin, or lmm-api-rs-git'
    fi
    ;;
  go|rs) ;;
  *) die "invalid LMM_API_BACKEND '$backend'; expected auto, go, or rs" ;;
esac

case $backend in
  go)
    [[ -x $GO_BINARY ]] || die 'Go backend is selected but no lmm-api-go provider is installed'
    exec "$GO_BINARY" "$@"
    ;;
  rs)
    [[ -x $RS_BINARY ]] || die 'Rust backend is selected but no lmm-api-rs provider is installed'
    [[ ${LMM_DATABASE_SCHEMA:-} == lmm_preview_* ]] || \
      die 'Rust preview requires LMM_DATABASE_SCHEMA=lmm_preview_*'
    : "${LMM_RS_SLOT:=preview}"
    : "${LMM_RS_LISTEN_ADDR:=127.0.0.1:${PORT:-3001}}"
    export LMM_RS_SLOT LMM_RS_LISTEN_ADDR
    exec "$RS_BINARY" "$@"
    ;;
esac
