make_copy() {
  local role=$1 output=$2 encrypted=false
  local config_name=configuration.archive database_name=database.archive
  [[ ! -e $output && ! -L $output ]] || exit 3
  mkdir -m0700 "$output"
  install -m0600 "$inputs/application.tar" "$output/application.archive"
  install -m0600 "$inputs/frontend.tar" "$output/frontend.archive"
  if [[ $role == target ]]; then
    install -m0600 "$inputs/configuration.tar" "$output/configuration.archive"
    install -m0600 "$inputs/postgresql.dump" "$output/database.archive"
  else
    age --encrypt --recipients-file "$recipient" \
      --output "$output/configuration.age" "$inputs/configuration.tar"
    age --encrypt --recipients-file "$recipient" \
      --output "$output/database.age" "$inputs/postgresql.dump"
    chmod 0600 "$output/configuration.age" "$output/database.age"
    encrypted=true; config_name=configuration.age; database_name=database.age
  fi
  created_at=$(date -u +%FT%TZ)
  {
    printf 'format=1\ncreated_at_utc=%s\ndeployment_id=%s\ncopy_role=%s\n' \
      "$created_at" "$id" "$role"
    printf 'deployment_role=production\nverified_host=arch-dmit\nrelease_id=%s\n' "$id"
    printf 'artifact_sha256=%s\ngit_revision=%s\ndatabase_engine=postgres\n' \
      "$artifact_sha" "$revision"
    printf 'core_sha256=%s\nbackend_sha256=%s\ncurrent_backend_sha256=%s\n' \
      "$core_sha" "$expected_backend_sha" "$backend_sha"
    printf 'service_state=active\nfrontend_release=%s\n' "$frontend_release"
    printf 'backend_package=%s\nbackend_pid=%s\n' "$backend_record" "$backend_pid"
    for pair in "application:application.archive:false" "frontend:frontend.archive:false" \
      "configuration:$config_name:$encrypted" "database:$database_name:$encrypted"; do
      kind=${pair%%:*}; remainder=${pair#*:}; filename=${remainder%%:*}
      encrypted_file=${remainder##*:}; file="$output/$filename"
      printf '%s_file=%s\n%s_size=%s\n%s_mode=%s\n%s_mtime_utc=%s\n' \
        "$kind" "$filename" "$kind" "$(stat -c %s "$file")" \
        "$kind" "$(stat -c %a "$file")" "$kind" \
        "$(date -u -d "@$(stat -c %Y "$file")" +%FT%TZ)"
      if [[ $kind == configuration || $kind == database ]]; then
        printf '%s_encrypted=%s\n' "$kind" "$encrypted_file"
      fi
    done
  } >"$output/manifest.env"
  sha256sum "$output/application.archive" "$output/frontend.archive" \
    "$output/$config_name" "$output/$database_name" | \
    sed "s|$output/||" >"$output/SHA256SUMS"
  chmod 0600 "$output/manifest.env" "$output/SHA256SUMS"
  (cd "$output" && sha256sum -c SHA256SUMS >/dev/null)
}
make_copy target "$target"
make_copy controller "$controller"
make_copy off-host "$offhost"
(cd "$target" && sha256sum -c SHA256SUMS >/dev/null)
grep -Fqx 'copy_role=target' "$target/manifest.env"
grep -Fqx 'configuration_encrypted=false' "$target/manifest.env"
grep -Fqx 'database_encrypted=false' "$target/manifest.env"
rm -f -- "$recipient"
