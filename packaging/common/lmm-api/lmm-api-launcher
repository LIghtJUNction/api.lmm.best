#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly LMM_API_DEPLOY_PROTOCOL_MIN=1
readonly LMM_API_DEPLOY_PROTOCOL_MAX=1
readonly LMM_API_BACKEND_ROOT=${LMM_API_BACKEND_ROOT:-/usr/lib/lmm-api/backends}
readonly LMM_API_GO_BINARY="$LMM_API_BACKEND_ROOT/go/lmm-api"
readonly LMM_API_RS_BINARY="$LMM_API_BACKEND_ROOT/rs/lmm-api-rs"
readonly LMM_API_CONFIG_PATH=${LMM_API_BACKEND_CONFIG:-/etc/lmm-api/backend.conf}
readonly EXPECTED_CONFIRMATION='api.lmm.best'
readonly EXPECTED_HOST='ArchDmit'
readonly DEFAULT_WORKSPACE="${XDG_STATE_HOME:-$HOME/.local/state}/lmm-api/deploy-work"
readonly DEFAULT_SSH_CONFIG="$HOME/.ssh/config"
readonly PRODUCTION_SSH_TARGET='root@45.59.187.63'
readonly PRODUCTION_SSH_PORT=222
readonly STATE_FILE_NAME='state'
readonly MARKER_NAME='.lmm-deploy-workspace'

cli_die() { printf 'lmm-api: %s\n' "$*" >&2; exit 78; }
backend_available() {
  case $1 in
    go) [[ -x $LMM_API_GO_BINARY && ! -L $LMM_API_GO_BINARY ]] ;;
    rs) [[ -x $LMM_API_RS_BINARY && ! -L $LMM_API_RS_BINARY ]] ;;
    *) return 1 ;;
  esac
}
configured_backend() {
  local value
  value=$(sed -nE 's/^[[:space:]]*LMM_API_BACKEND=(auto|go|rs)[[:space:]]*$/\1/p' \
    "$LMM_API_CONFIG_PATH" 2>/dev/null | tail -n1)
  printf '%s\n' "${value:-auto}"
}
resolved_backend() {
  local selected=${1:-auto}
  case $selected in
    go|rs) backend_available "$selected" && printf '%s\n' "$selected" || printf '%s\n' unavailable ;;
    auto) if backend_available go; then printf '%s\n' go; elif backend_available rs; then printf '%s\n' rs; else printf '%s\n' unavailable; fi ;;
    *) printf '%s\n' unavailable ;;
  esac
}
write_backend_selection() {
  local selection=$1 config_dir temporary
  case $selection in auto|go|rs) ;; *) cli_die 'select expects auto, go, or rs' ;; esac
  backend_available "$selection" || [[ $selection == auto ]] || cli_die "$selection backend is not installed"
  config_dir=${LMM_API_CONFIG_PATH%/*}
  [[ -d $config_dir && ! -L $config_dir ]] || cli_die "missing config directory: $config_dir"
  temporary=$(mktemp "${LMM_API_CONFIG_PATH}.tmp.XXXXXXXX")
  trap 'rm -f -- "$temporary"' RETURN
  printf '# Managed by lmm-api.\nLMM_API_BACKEND=%s\n' "$selection" >"$temporary"
  chmod 0644 "$temporary"
  mv -f -- "$temporary" "$LMM_API_CONFIG_PATH"
  trap - RETURN
  printf 'selected=%s\nresolved=%s\n' "$selection" "$(resolved_backend "$selection")"
}
validate_no_symlink_components() {
  local path=$1 component current=/ parts
  [[ $path == /* ]] || return 1
  path=${path#/}
  IFS=/ read -r -a parts <<<"$path"
  for component in "${parts[@]}"; do
    [[ -n $component && $component != . && $component != .. ]] || return 1
    [[ $current == / ]] || current+=/
    current+=$component
    [[ -e $current && ! -L $current ]] || return 1
  done
}
validate_owned_directory() {
  local path=$1 expected_uid=$2 mode
  [[ -d $path && ! -L $path ]] || return 1
  [[ $(stat -c '%u' -- "$path") == "$expected_uid" ]] || return 1
  mode=$(stat -c '%a' -- "$path")
  (( (8#$mode & 18#022) == 0 ))
}
validate_owned_file() {
  local path=$1 expected_uid=$2 expected_mode=$3
  [[ -f $path && ! -L $path ]] || return 1
  [[ $(stat -c '%u' -- "$path") == "$expected_uid" ]] || return 1
  [[ $(stat -c '%a' -- "$path") == "$expected_mode" ]]
}
run_internal_watchdog() {
  local action='' deployment_id='' workspace_root canonical_root workspace state staging marker guard runtime target_backup status_file runtime_sha256 expected_runtime expected_uid
  local core_package backend_package expected_release expected_revision frontend_digest
  while (($#)); do
    case $1 in
      watchdog|rollback) action=$1; shift ;;
      --deployment-id) (($# >= 2)) || cli_die '--deployment-id requires a value'; deployment_id=$2; shift 2 ;;
      *) cli_die "unknown internal deploy argument: $1" ;;
    esac
  done
  [[ $action == watchdog || $action == rollback ]] || cli_die 'internal watchdog action is required'
  [[ $deployment_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || cli_die 'invalid deployment id'
  workspace_root=/var/lib/lmm-api/deploy-work
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 1 )); then
    workspace_root=${LMM_API_DEPLOY_WORKSPACE_ROOT:-$workspace_root}
  fi
  validate_no_symlink_components "$workspace_root" || cli_die 'watchdog workspace path contains a symlink or non-canonical component'
  canonical_root=$(realpath -e -- "$workspace_root") || cli_die 'watchdog workspace is unavailable'
  [[ $workspace_root == "$canonical_root" ]] || cli_die 'watchdog workspace root is not canonical'
  expected_uid=0
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 1 )); then expected_uid=$EUID; fi
  validate_owned_directory "$canonical_root" "$expected_uid" || cli_die 'watchdog workspace root ownership or mode is unsafe'
  workspace="$canonical_root/$deployment_id"
  state="$workspace/state"
  staging="$workspace/staging"
  marker="$workspace/$MARKER_NAME"
  guard="$state/rollback.guard"
  status_file="$staging/status"
  validate_no_symlink_components "$workspace" || cli_die 'watchdog deployment path contains a symlink or non-canonical component'
  [[ $(realpath -e -- "$workspace") == "$workspace" ]] || cli_die 'watchdog deployment path is not canonical'
  validate_owned_directory "$workspace" "$expected_uid" || cli_die 'watchdog deployment ownership or mode is unsafe'
  if ! validate_no_symlink_components "$state" || ! validate_no_symlink_components "$staging"; then
    cli_die 'watchdog transaction path contains a symlink or non-canonical component'
  fi
  [[ $(realpath -e -- "$state") == "$state" && $(realpath -e -- "$staging") == "$staging" ]] ||
    cli_die 'watchdog transaction path is not canonical'
  validate_owned_directory "$state" "$expected_uid" || cli_die 'watchdog state ownership or mode is unsafe'
  validate_owned_directory "$staging" "$expected_uid" || cli_die 'watchdog staging ownership or mode is unsafe'
  if ! validate_no_symlink_components "$marker" || ! validate_owned_file "$marker" "$expected_uid" 600; then
    cli_die 'watchdog workspace marker is unsafe'
  fi
  grep -Fqx "deployment_id=$deployment_id" "$marker" || cli_die 'watchdog workspace marker identity mismatch'
  grep -Fqx 'role=target' "$marker" || cli_die 'watchdog workspace marker role mismatch'
  grep -Fqx "workspace=$workspace" "$marker" || cli_die 'watchdog workspace marker path mismatch'
  if ! validate_no_symlink_components "$guard" || ! validate_owned_file "$guard" "$expected_uid" 600; then
    cli_die 'watchdog guard is unsafe'
  fi
  grep -Fqx "deployment_id=$deployment_id" "$guard" || cli_die 'watchdog deployment identity mismatch'
  target_backup=$(sed -n 's/^target_backup=//p' "$guard")
  core_package="$workspace/staging/core.pkg"
  backend_package="$workspace/staging/backend.pkg"
  expected_release=$(sed -n 's/^new_frontend=releases\///p' "$guard")
  expected_revision=$(sed -n 's/^git_revision=//p' "$guard")
  frontend_digest=$(sed -n 's/^frontend_digest=//p' "$guard")
  expected_runtime=$(sed -n 's/^watchdog_runtime=//p' "$guard")
  runtime_sha256=$(sed -n 's/^watchdog_runtime_sha256=//p' "$guard")
  [[ $expected_runtime == "$workspace/staging/activate-rust-release.sh" || \
    $expected_runtime == "$workspace/staging/frontend-activator" ]] || cli_die 'watchdog runtime path is invalid'
  [[ $runtime_sha256 =~ ^[0-9a-f]{64}$ ]] || cli_die 'watchdog runtime checksum is missing or invalid'
  if [[ -f $workspace/staging/activate-rust-release.sh && ! -L $workspace/staging/activate-rust-release.sh ]]; then
    runtime=$workspace/staging/activate-rust-release.sh
    [[ $runtime == "$expected_runtime" ]] || cli_die 'watchdog runtime mode/path mismatch'
    [[ $(sha256sum "$runtime" | awk '{print $1}') == "$runtime_sha256" ]] || cli_die 'watchdog runtime checksum mismatch'
    exec "$runtime" --rollback-only --workspace "$workspace" --guard "$guard" \
      --target-backup "$target_backup" --rollback-core "$workspace/staging/rollback-core.pkg" \
      --rollback-backend "$workspace/staging/rollback-backend.pkg" \
      --frontend-release-script "$workspace/staging/frontend-release.sh" \
      --core-package "$core_package" --core-sha256 "$(sed -n 's/^core_sha256=//p' "$guard")" \
      --backend-package "$backend_package" --backend-sha256 "$(sed -n 's/^backend_sha256=//p' "$guard")" \
      --expected-release "$expected_release" --expected-revision "$expected_revision" \
      --status-file "$status_file"
  fi
  if [[ -f $workspace/staging/frontend-activator && ! -L $workspace/staging/frontend-activator ]]; then
    runtime=$workspace/staging/frontend-activator
    [[ $runtime == "$expected_runtime" ]] || cli_die 'watchdog runtime mode/path mismatch'
    [[ $(sha256sum "$runtime" | awk '{print $1}') == "$runtime_sha256" ]] || cli_die 'watchdog runtime checksum mismatch'
    exec "$runtime" rollback --workspace "$workspace" --guard "$guard" \
      --target-backup "$target_backup" --core-package "$core_package" \
      --core-sha256 "$(sed -n 's/^core_sha256=//p' "$guard")" \
      --expected-release "$expected_release" --expected-revision "$expected_revision" \
      --frontend-digest "$frontend_digest" --status-file "$status_file"
  fi
  cli_die 'watchdog runtime payload is missing or unsafe'
}
show_protocol() {
  printf 'min=%s\nmax=%s\n' "$LMM_API_DEPLOY_PROTOCOL_MIN" "$LMM_API_DEPLOY_PROTOCOL_MAX"
}
show_usage() {
  cat <<'EOF'
Usage:
  lmm-api serve [provider args...]
  lmm-api select auto|go|rs|status
  lmm-api status
  lmm-api doctor
  lmm-api deploy production [options] [preflight|inspect|build|package|backup|watchdog|switch|confirm|rollback|cleanup]
  lmm-api deploy internal watchdog --deployment-id ID

Required production options:
  --backend go|rs       Backend provider (required for backend updates)
  --frontend-only       Publish only the frontend from an exact lmm-api-bin/lmm-api-git package
  --host ArchDmit       Target host role (required; exact spelling)
  --deployment-id ID    Stable transaction identity (required for every phase)
  --jump-host archczy   Optional SSH controller jump host (exact spelling)
  --ssh-config PATH     Owner-controlled SSH config containing the archczy alias
  --remote-inspect      Read sanitized target state through SSH
  --route-gate PATH     Authoritative Rust migration/route-parity gate
  --confirm api.lmm.best Exact production confirmation (required for confirm)

Transaction options:
  --workspace PATH      Persistent marker-owned workspace
  --target-backup PATH  Target backup-set directory
  --controller-backup PATH  Controller backup-set directory
  --offhost-backup PATH Off-host backup-set directory
  --core-package PATH   Built lmm-api core AUR package (includes frontend)
  --backend-package PATH Built provider AUR package for --backend (backend updates only)
  --execute-cleanup     Remove only this finalized marker-owned workspace
  --execute-remote      Perform the explicitly requested target switch
  --create-backups      Create/promote target, controller, and off-host copies
  --age-recipient-file PATH  Public age recipient file for secret-bearing copies
  --help

Each backup directory must pass role, identity, encryption, and checksum gates.

The default is a read-only preflight. Backend production is a gated staged
transaction: route and migration evidence, exact package identity, backups,
watchdog preparation, target activation, and explicit confirmation are checked
before a remote switch. Frontend-only production validates and publishes the
core package's frontend bytes while leaving the current Go backend untouched.
Build/package/switch stage local markers unless --execute-remote is explicitly
requested.
EOF
}
die() { printf 'lmm-api: %s\n' "$*" >&2; exit 2; }
log() { printf 'lmm-api deploy: %s\n' "$*"; }
usage() { show_usage; }

command=${1:-help}
case $command in
  serve)
    shift
    backend=${LMM_API_BACKEND:-$(configured_backend)}
    case $backend in auto) backend=$(resolved_backend auto) ;; go|rs) ;; *) cli_die "invalid LMM_API_BACKEND '$backend'; expected auto, go, or rs" ;; esac
    case $backend in
      go) backend_available go || cli_die 'Go backend is selected but no provider is installed'; exec "$LMM_API_GO_BINARY" "$@" ;;
      rs) backend_available rs || cli_die 'Rust backend is selected but no provider is installed'; : "${LMM_RS_SLOT:=blue}"; : "${LMM_RS_LISTEN_ADDR:=127.0.0.1:${PORT:-3001}}"; export LMM_RS_SLOT LMM_RS_LISTEN_ADDR; exec "$LMM_API_RS_BINARY" "$@" ;;
      unavailable) cli_die 'no backend is installed; install an lmm-api provider' ;;
    esac
    ;;
  select)
    shift
    case ${1:-} in status) (($# == 1)) || cli_die 'select status takes no arguments'; selected=$(configured_backend); printf 'configured=%s\nresolved=%s\ngo=%s\nrs=%s\n' "$selected" "$(resolved_backend "$selected")" "$(backend_available go && printf installed || printf missing)" "$(backend_available rs && printf installed || printf missing)" ;; auto|go|rs) (($# == 1)) || cli_die 'select takes exactly one backend'; write_backend_selection "$1" ;; *) cli_die 'select expects auto, go, rs, or status' ;; esac
    exit 0
    ;;
  status)
    selected=$(configured_backend); printf 'configured=%s\nresolved=%s\ngo=%s\nrs=%s\n' "$selected" "$(resolved_backend "$selected")" "$(backend_available go && printf installed || printf missing)" "$(backend_available rs && printf installed || printf missing)"; exit 0
    ;;
  doctor)
    printf 'LMM API Doctor\n'; printf 'launcher=%s\nprotocol=%s-%s\ngo=%s\nrs=%s\n' "$0" "$LMM_API_DEPLOY_PROTOCOL_MIN" "$LMM_API_DEPLOY_PROTOCOL_MAX" "$(backend_available go && printf OK || printf missing)" "$(backend_available rs && printf OK || printf missing)"; exit 0
    ;;
  help|--help|-h)
    show_usage; exit 0
    ;;
  version|--version)
    shift
    backend=$(resolved_backend "${LMM_API_BACKEND:-$(configured_backend)}")
    case $backend in
      go) exec "$LMM_API_GO_BINARY" --version "$@" ;;
      rs) exec "$LMM_API_RS_BINARY" --version "$@" ;;
      *) cli_die 'no backend is installed; cannot report provider version' ;;
    esac
    ;;
  deploy)
    shift
    if [[ ${1:-} == internal ]]; then
      shift
      if [[ ${1:-} == protocol ]]; then (($# == 1)) || cli_die 'internal protocol takes no arguments'; show_protocol; exit 0; fi
      run_internal_watchdog "$@"
    fi
    ;;
  *)
    show_usage >&2
    exit 64
    ;;
esac

BACKEND=''
FRONTEND_ONLY=0
TARGET_HOST=''
CONFIRM=''
CONTROLLER='local'
JUMP_HOST=''
REMOTE_INSPECT=0
ROUTE_GATE=''
DEPLOYMENT_ID=''
WORKSPACE=${LMM_API_DEPLOY_WORKSPACE:-$DEFAULT_WORKSPACE}
TARGET_BACKUP=''
CONTROLLER_BACKUP=''
OFFHOST_BACKUP=''
CORE_PACKAGE=''
BACKEND_PACKAGE=''
EXECUTE_CLEANUP=0
EXECUTE_REMOTE=0
CREATE_BACKUPS=0
AGE_RECIPIENT_FILE=''
SSH_CONFIG=${LMM_API_DEPLOY_SSH_CONFIG:-$DEFAULT_SSH_CONFIG}
PHASE='preflight'
PHASE_SET=0

# Frontend-only backup creation owns a single remote transaction until all
# three copies have been verified.  These globals are used by the EXIT trap
# so a failed transfer can remove only paths claimed by this invocation.
FRONTEND_BACKUP_ACTIVE=0
FRONTEND_BACKUP_SUCCEEDED=0
FRONTEND_BACKUP_REMOTE_TRANSACTION=''
FRONTEND_BACKUP_TARGET_OUTPUT=''
FRONTEND_BACKUP_CONTROLLER_REMOTE=''
FRONTEND_BACKUP_OFFHOST_REMOTE=''
FRONTEND_BACKUP_CONTROLLER_OUTPUT=''
FRONTEND_BACKUP_OFFHOST_OUTPUT=''
FRONTEND_BACKUP_OFFHOST_MIRROR=''
FRONTEND_BACKUP_LOCK_CREATED=0
FRONTEND_BACKUP_REMOTE_TRANSACTION_OWNED=0
FRONTEND_BACKUP_TARGET_OUTPUT_OWNED=0
FRONTEND_BACKUP_CONTROLLER_REMOTE_OWNED=0
FRONTEND_BACKUP_OFFHOST_REMOTE_OWNED=0
FRONTEND_BACKUP_CONTROLLER_OUTPUT_OWNED=0
FRONTEND_BACKUP_OFFHOST_OUTPUT_OWNED=0
FRONTEND_BACKUP_OFFHOST_MIRROR_OWNED=0
FRONTEND_BACKUP_SSH_CONFIG=''
FRONTEND_BACKUP_JUMP_HOST=''
FRONTEND_BACKUP_SSH_BIN='ssh'
FRONTEND_BACKUP_SCP_BIN='scp'
FRONTEND_BACKUP_SSH_PORT=$PRODUCTION_SSH_PORT

# shellcheck disable=SC2329 # Invoked by the EXIT trap after backup ownership is claimed.
cleanup_frontend_backup_transaction() {
  local -a ssh_cmd offhost_cmd
  (( FRONTEND_BACKUP_ACTIVE == 1 && FRONTEND_BACKUP_SUCCEEDED == 0 )) || return 0
  set +e
  [[ -n $FRONTEND_BACKUP_SSH_CONFIG && -n $FRONTEND_BACKUP_JUMP_HOST ]] || return 0
  ssh_cmd=("$FRONTEND_BACKUP_SSH_BIN" -F "$FRONTEND_BACKUP_SSH_CONFIG" -J \
    "$FRONTEND_BACKUP_JUMP_HOST" -p "$FRONTEND_BACKUP_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  offhost_cmd=("$FRONTEND_BACKUP_SSH_BIN" -F "$FRONTEND_BACKUP_SSH_CONFIG" \
    "$FRONTEND_BACKUP_JUMP_HOST")
  (( FRONTEND_BACKUP_CONTROLLER_OUTPUT_OWNED == 1 )) &&
    rm -rf -- "$FRONTEND_BACKUP_CONTROLLER_OUTPUT"
  (( FRONTEND_BACKUP_OFFHOST_MIRROR_OWNED == 1 )) &&
    rm -rf -- "$FRONTEND_BACKUP_OFFHOST_MIRROR"
  if (( FRONTEND_BACKUP_OFFHOST_OUTPUT_OWNED == 1 )); then
    "${offhost_cmd[@]}" rm -rf -- "$FRONTEND_BACKUP_OFFHOST_OUTPUT"
  fi
  if (( FRONTEND_BACKUP_CONTROLLER_REMOTE_OWNED == 1 )); then
    "${ssh_cmd[@]}" rm -rf -- "$FRONTEND_BACKUP_CONTROLLER_REMOTE"
  fi
  if (( FRONTEND_BACKUP_OFFHOST_REMOTE_OWNED == 1 )); then
    "${ssh_cmd[@]}" rm -rf -- "$FRONTEND_BACKUP_OFFHOST_REMOTE"
  fi
  if (( FRONTEND_BACKUP_TARGET_OUTPUT_OWNED == 1 )); then
    "${ssh_cmd[@]}" rm -rf -- "$FRONTEND_BACKUP_TARGET_OUTPUT"
  fi
  if (( FRONTEND_BACKUP_LOCK_CREATED == 1 )) && [[ -n $FRONTEND_BACKUP_REMOTE_TRANSACTION ]]; then
    "${ssh_cmd[@]}" bash -s -- "$(encode_remote_value "${FRONTEND_BACKUP_REMOTE_TRANSACTION##*/}")" <<'EOF'
set -Eeuo pipefail
decode() { printf '%s' "$1" | base64 --decode; }
id=$(decode "$1")
lock=/var/lib/lmm-api/deploy-transaction.lock
marker="$lock/deployment.env"
if [[ -d $lock && ! -L $lock && -f $marker && ! -L $marker ]] && \
  grep -Fqx "deployment_id=$id" "$marker"; then
  rm -f -- "$marker"
  rmdir -- "$lock"
fi
EOF
  fi
  if (( FRONTEND_BACKUP_REMOTE_TRANSACTION_OWNED == 1 )); then
    "${ssh_cmd[@]}" rm -rf -- "$FRONTEND_BACKUP_REMOTE_TRANSACTION"
  fi
}

[[ ${1:-} == production ]] || die "expected 'production' scope"
shift

is_safe_path() {
  [[ $1 == /* && $1 != *$'\n'* && $1 != *$'\r'* && $1 != *'..'* ]]
}
is_sha256() { [[ ${1:-} =~ ^[[:xdigit:]]{64}$ ]]; }
is_safe_remote_credential_path() {
  local path=${1:-} component
  local -a components
  [[ $path =~ ^/[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$ ]] || return 1
  IFS=/ read -r -a components <<<"${path#/}"
  for component in "${components[@]}"; do
    [[ -n $component && $component != . && $component != .. ]] || return 1
  done
}
encode_remote_value() {
  printf '%s' "$1" | base64 --wrap=0
}
remote_transaction_root() {
  local root=/var/lib/lmm-api/deploy-work
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 1 )) && [[ -n ${LMM_DEPLOY_TEST_REMOTE_ROOT:-} ]]; then
    root=$LMM_DEPLOY_TEST_REMOTE_ROOT
    is_safe_path "$root" || die 'test remote deployment root is unsafe'
  fi
  printf '%s/%s\n' "$root" "$transaction_id"
}
remote_run_activator() {
  local mode=$1 acceptance_file=$2 target_backup=$3 core_sha=$4 backend_sha=$5 revision=$6 route_sha=$7
  local remote_transaction remote_root
  local -a encoded ssh_cmd values
  [[ $mode == prepare || $mode == switch || $mode == confirm ]] || die 'invalid remote activator mode'
  remote_transaction=$(remote_transaction_root)
  remote_root="$remote_transaction/staging"
  values=(
    "$acceptance_file"
    "$remote_root/activate-rust-release.sh"
    "$remote_transaction"
    "$remote_transaction/state/rollback.guard"
    "$target_backup"
    "$remote_root/core.pkg" "$core_sha"
    "$remote_root/backend.pkg" "$backend_sha"
    "$remote_root/rollback-core.pkg" "$remote_root/rollback-backend.pkg"
    "$remote_root/frontend-release.sh"
    "$transaction_id" "$revision"
    "$remote_root/${ROUTE_GATE##*/}" "$route_sha" "$remote_root/status"
  )
  for value in "${values[@]}"; do encoded+=("$(encode_remote_value "$value")"); done
  ssh_cmd=(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  "${ssh_cmd[@]}" bash -s -- "$mode" "${encoded[@]}" <<'EOF'
set -Eeuo pipefail
mode=$1
shift
decode() { printf '%s' "$1" | base64 --decode; }
acceptance_file=$(decode "$1"); activator=$(decode "$2"); workspace=$(decode "$3"); guard=$(decode "$4")
target_backup=$(decode "$5"); core_package=$(decode "$6"); core_sha=$(decode "$7")
backend_package=$(decode "$8"); backend_sha=$(decode "$9"); rollback_core=$(decode "${10}")
rollback_backend=$(decode "${11}"); frontend_script=$(decode "${12}"); release=$(decode "${13}")
revision=$(decode "${14}"); route_gate=$(decode "${15}"); route_sha=$(decode "${16}"); status=$(decode "${17}")
common=(
  --workspace "$workspace" --guard "$guard" --target-backup "$target_backup"
  --core-package "$core_package" --core-sha256 "$core_sha"
  --backend-package "$backend_package" --backend-sha256 "$backend_sha"
  --expected-release "$release" --expected-revision "$revision" --status-file "$status"
)
case $mode in
  prepare)
    env "LMM_ACCEPTANCE_CREDENTIAL_FILE=$acceptance_file" "$activator" --prepare-only \
      "${common[@]}" --frontend-release-script "$frontend_script" \
      --route-gate "$route_gate" --route-gate-sha256 "$route_sha"
    ;;
  switch)
    env "LMM_ACCEPTANCE_CREDENTIAL_FILE=$acceptance_file" "$activator" \
      "${common[@]}" --rollback-core "$rollback_core" --rollback-backend "$rollback_backend" \
      --frontend-release-script "$frontend_script" --route-gate "$route_gate" --route-gate-sha256 "$route_sha"
    ;;
  confirm)
    "$activator" --confirm-only "${common[@]}"
    ;;
  *) exit 64 ;;
esac
EOF
}

SOURCE_REPO_ROOT=''
INSTALLED_CORE_PACKAGE=''
INSTALLED_CORE_RECORD=''
INSTALLED_REVISION=''

detect_execution_context() {
  local script_dir candidate
  script_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
  candidate=$(cd -- "$script_dir/../../.." 2>/dev/null && pwd -P || true)
  if [[ -d $candidate/.git ]]; then
    SOURCE_REPO_ROOT=$candidate
  fi
}

validate_installed_cli_context() {
  local cli_path libdir owner package_record revision_path path integrity_status
  local -a owned_paths
  [[ -z $SOURCE_REPO_ROOT ]] || return 0
  for command in pacman realpath sed; do
    command -v "$command" >/dev/null 2>&1 || die "installed deployment authentication requires $command"
  done
  cli_path=$(realpath -e -- "$0") || die 'installed deployment CLI path cannot be resolved'
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 1 )); then
    libdir=${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}
  else
    [[ $cli_path == /usr/bin/lmm-api ]] || die 'installed deployment CLI path is not canonical'
    libdir=/usr/lib/lmm-api/deploy
  fi
  if (( ! FRONTEND_ONLY )); then
    [[ -d $libdir && ! -L $libdir ]] || die 'installed deployment asset directory is missing or unsafe'
  fi
  owner=$(LC_ALL=C pacman -Qqo -- "$cli_path") || die 'installed deployment CLI has no package owner'
  [[ $owner == lmm-api-bin || $owner == lmm-api-git ]] || die 'installed deployment CLI owner is not an exact core package'
  package_record=$(LC_ALL=C pacman -Q "$owner") || die 'installed core package identity is unavailable'
  [[ $package_record == "$owner "* && ${package_record#* } != *[[:space:]]* ]] || \
    die 'installed core package name/version record is invalid'
  case $owner in
    lmm-api-bin) revision_path=/usr/share/doc/lmm-api-bin/REVISION ;;
    lmm-api-git) revision_path=/usr/share/doc/lmm-api-git/REVISION ;;
  esac
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 1 )) && [[ -n ${LMM_API_DEPLOY_REVISION_PATH:-} ]]; then
    revision_path=$LMM_API_DEPLOY_REVISION_PATH
  fi
  owned_paths=("$cli_path" "$revision_path")
  if (( ! FRONTEND_ONLY )); then
    owned_paths+=(
      "$libdir/validate-route-gate" "$libdir/migration-gate.tsv" "$libdir/frozen-route-auth.tsv"
      "$libdir/migration-compatibility.env" "$libdir/route-gate-assets.sha256"
      "$libdir/production-acceptance.mjs" "$libdir/production-acceptance-lib.mjs"
    )
  fi
  for path in "${owned_paths[@]}"; do
    [[ -f $path && ! -L $path ]] || die "installed core package asset is missing or unsafe: $path"
    [[ $(LC_ALL=C pacman -Qqo -- "$path") == "$owner" ]] || \
      die "installed core package asset ownership mismatch: $path"
  done
  integrity_status=0
  LC_ALL=C pacman -Qkk -- "$owner" >/dev/null || integrity_status=$?
  (( integrity_status == 0 )) || die 'installed core package integrity check failed'
  INSTALLED_REVISION=$(sed -n '1p' "$revision_path")
  [[ $INSTALLED_REVISION =~ ^[0-9a-fA-F]{7,64}$ ]] || die 'installed core package revision is invalid'
  INSTALLED_CORE_PACKAGE=$owner
  INSTALLED_CORE_RECORD=$package_record
}

resolve_revision() {
  local revision
  if [[ -n $SOURCE_REPO_ROOT ]] && revision=$(git -C "$SOURCE_REPO_ROOT" rev-parse HEAD 2>/dev/null); then
    :
  else
    [[ -n $INSTALLED_CORE_PACKAGE && -n $INSTALLED_CORE_RECORD && -n $INSTALLED_REVISION ]] || \
      die 'installed core package context was not authenticated'
    revision=$INSTALLED_REVISION
  fi
  [[ $revision =~ ^[0-9a-fA-F]{7,64}$ ]] || die 'current release revision is invalid'
  printf '%s\n' "$revision"
}

extract_embedded_runtime() {
  local name=$1 output=$2 begin="__LMM_${1}_BEGIN__" end="__LMM_${1}_END__"
  awk -v begin="$begin" -v end="$end" '
    $0 == begin { copying=1; found_begin++; next }
    $0 == end { copying=0; found_end++; next }
    copying { print }
    END { if (found_begin != 1 || found_end != 1 || copying) exit 2 }
  ' "$0" >"$output.new" || {
    rm -f -- "$output.new"
    die "embedded runtime payload is unavailable: $name"
  }
  [[ -s $output.new ]] || {
    rm -f -- "$output.new"
    die "embedded runtime payload is empty: $name"
  }
  chmod 0700 "$output.new"
  mv -Tf -- "$output.new" "$output"
}

write_embedded_backend_runtime() {
  extract_embedded_runtime BACKEND_ACTIVATOR "$transaction_dir/activate-rust-release.sh"
  extract_embedded_runtime FRONTEND_RELEASE "$transaction_dir/frontend-release.sh"
  bash -n "$transaction_dir/activate-rust-release.sh" || die 'embedded backend activator has invalid syntax'
  bash -n "$transaction_dir/frontend-release.sh" || die 'embedded frontend publisher has invalid syntax'
}

core_package_protocol_bounds() {
  local package=$1 source minimum maximum
  source=$(bsdtar -xOf "$package" usr/bin/lmm-api) || die 'core package canonical CLI is missing'
  minimum=$(sed -nE 's/^readonly LMM_API_DEPLOY_PROTOCOL_MIN=([0-9]+)$/\1/p' <<<"$source")
  maximum=$(sed -nE 's/^readonly LMM_API_DEPLOY_PROTOCOL_MAX=([0-9]+)$/\1/p' <<<"$source")
  [[ $minimum =~ ^[0-9]+$ && $maximum =~ ^[0-9]+$ && $minimum -le $maximum ]] || \
    die 'core package deployment protocol declaration is invalid'
  printf '%s %s\n' "$minimum" "$maximum"
}
validate_core_package_protocol() {
  local package=$1 minimum maximum
  read -r minimum maximum < <(core_package_protocol_bounds "$package")
  (( minimum <= LMM_API_DEPLOY_PROTOCOL_MAX && LMM_API_DEPLOY_PROTOCOL_MIN <= maximum )) || \
    die "core package deployment protocol is incompatible: package=$minimum-$maximum cli=$LMM_API_DEPLOY_PROTOCOL_MIN-$LMM_API_DEPLOY_PROTOCOL_MAX"
}

validate_staged_artifacts() {
  local core_path=${1:-$transaction_dir/core.pkg}
  local backend_path=${2:-$transaction_dir/backend.pkg}
  local expected_revision core_record backend_record core_arch backend_arch core_embedded backend_embedded
  local core_sha backend_sha
  [[ $BACKEND == rs ]] || die 'production artifacts must use the Rust provider package'
  for command in pacman bsdtar sha256sum; do
    command -v "$command" >/dev/null 2>&1 || die "required package validation command is unavailable: $command"
  done
  [[ -f $core_path && ! -L $core_path && -f $backend_path && ! -L $backend_path ]] || \
    die 'staged production packages are missing or symlinked'
  validate_core_package_protocol "$core_path"
  expected_revision=$(resolve_revision)
  core_record=$(LC_ALL=C pacman -Qp "$core_path") || die 'core package metadata query failed'
  backend_record=$(LC_ALL=C pacman -Qp "$backend_path") || die 'Rust package metadata query failed'
  [[ $core_record == lmm-api-bin\ * && $core_record != *-git\ * ]] || die 'staged core package is not exact lmm-api-bin'
  [[ $backend_record == lmm-api-rs-bin\ * && $backend_record != *-git\ * ]] || die 'staged provider package is not exact lmm-api-rs-bin'
  core_arch=$(LC_ALL=C pacman -Qip "$core_path" | awk -F ': ' '$1 ~ /^Architecture[[:space:]]*$/ { print $2; exit }')
  backend_arch=$(LC_ALL=C pacman -Qip "$backend_path" | awk -F ': ' '$1 ~ /^Architecture[[:space:]]*$/ { print $2; exit }')
  [[ $core_arch == any && $backend_arch == x86_64 ]] || die 'staged package architecture identity is invalid'
  core_embedded=$(bsdtar -xOf "$core_path" usr/share/doc/lmm-api-bin/REVISION) || die 'core package revision is missing'
  backend_embedded=$(bsdtar -xOf "$backend_path" usr/share/doc/lmm-api-rs-bin/REVISION) || die 'Rust package revision is missing'
  [[ $core_embedded == "$expected_revision" && $backend_embedded == "$expected_revision" ]] || \
    die 'embedded package revisions disagree with the expected revision'
  core_sha=$(sha256sum "$core_path" | awk '{print $1}')
  backend_sha=$(sha256sum "$backend_path" | awk '{print $1}')
  printf 'core_package=%s\nbackend_package=%s\ncore_arch=%s\nbackend_arch=%s\nrevision=%s\ncore_sha256=%s\nbackend_sha256=%s\n' \
    "$core_record" "$backend_record" "$core_arch" "$backend_arch" "$expected_revision" \
    "$core_sha" "$backend_sha" \
    >"$transaction_dir/package.identity.new"
  chmod 0600 "$transaction_dir/package.identity.new"
  if [[ -f $transaction_dir/package.identity && ! -L $transaction_dir/package.identity ]]; then
    cmp -s "$transaction_dir/package.identity.new" "$transaction_dir/package.identity" || \
      die 'staged package identity changed after initial validation'
    rm -f -- "$transaction_dir/package.identity.new"
  else
    mv -Tf -- "$transaction_dir/package.identity.new" "$transaction_dir/package.identity"
  fi
  if [[ -f $transaction_dir/SHA256SUMS && ! -L $transaction_dir/SHA256SUMS ]]; then
    (cd "$transaction_dir" && sha256sum -c SHA256SUMS >/dev/null) || \
      die 'staged package bytes changed after checksum recording'
  fi
}

frontend_tree_digest() {
  local root=$1 path relative hash_record hash
  [[ -d $root && ! -L $root && -f $root/index.html && ! -L $root/index.html ]] || \
    die 'frontend-dist must be a regular directory containing index.html'
  if find "$root" \( -type l -o \( ! -type f ! -type d \) \) -print -quit | grep -q .; then
    die 'frontend-dist contains symlinks or unsupported file types'
  fi
  find "$root" -type f -print -quit | grep -q . || die 'frontend-dist is empty'
  {
    while IFS= read -r -d '' path; do
      relative=${path#"$root"/}
      IFS= read -r -d '' hash_record < <(sha256sum --zero -- "$path") || \
        die 'frontend file hashing failed'
      hash=${hash_record%% *}
      [[ $hash =~ ^[0-9a-f]{64}$ ]] || die 'frontend file hash is invalid'
      printf '%s\0%s\0' "$relative" "$hash"
    done < <(find "$root" -type f -print0 | LC_ALL=C sort -z)
  } | sha256sum | awk '{print $1}'
}

validate_frontend_artifact() {
  local core_path=${1:-$transaction_dir/core.pkg}
  local expected_revision core_record core_name core_arch embedded frontend_stage digest revision_member
  for command in pacman bsdtar sha256sum; do
    command -v "$command" >/dev/null 2>&1 || die "required package validation command is unavailable: $command"
  done
  [[ -f $core_path && ! -L $core_path ]] || die 'staged core package is missing or symlinked'
  validate_core_package_protocol "$core_path"
  expected_revision=$(resolve_revision)
  core_record=$(LC_ALL=C pacman -Qp "$core_path") || die 'core package metadata query failed'
  core_name=${core_record%% *}
  case $core_name in lmm-api-bin|lmm-api-git) ;; *) die 'frontend-only package must be exact lmm-api-bin or lmm-api-git' ;; esac
  core_arch=$(LC_ALL=C pacman -Qip "$core_path" | awk -F ': ' '$1 ~ /^Architecture[[:space:]]*$/ { print $2; exit }')
  [[ $core_arch == any ]] || die 'frontend-only core package architecture must be any'
  revision_member="usr/share/doc/$core_name/REVISION"
  embedded=$(bsdtar -xOf "$core_path" "$revision_member") || \
    die 'core package revision is missing'
  [[ $embedded == "$expected_revision" ]] || die 'core package revision disagrees with the expected revision'
  frontend_stage="$transaction_dir/frontend-dist"
  if [[ ! -e $frontend_stage && ! -L $frontend_stage ]]; then
    mkdir -m0700 -- "$frontend_stage"
    bsdtar -xf "$core_path" -C "$frontend_stage" usr/share/lmm-api/frontend-dist || {
      rm -rf -- "$frontend_stage"
      die 'frontend-dist extraction failed'
    }
  else
    [[ -d $frontend_stage && ! -L $frontend_stage ]] || die 'frontend extraction directory is unsafe'
  fi
  [[ -d $frontend_stage/usr/share/lmm-api/frontend-dist ]] || {
    rm -rf -- "$frontend_stage"
    die 'core package does not contain frontend-dist'
  }
  digest=$(frontend_tree_digest "$frontend_stage/usr/share/lmm-api/frontend-dist")
  printf 'core_package=%s\ncore_arch=%s\nrevision=%s\nfrontend_release=%s\ncore_sha256=%s\nfrontend_digest=%s\n' \
    "$core_record" "$core_arch" "$expected_revision" \
    "$embedded" "$(sha256sum "$core_path" | awk '{print $1}')" "$digest" >"$transaction_dir/frontend.identity.new"
  chmod 0600 "$transaction_dir/frontend.identity.new"
  if [[ -f $transaction_dir/frontend.identity && ! -L $transaction_dir/frontend.identity ]]; then
    cmp -s "$transaction_dir/frontend.identity.new" "$transaction_dir/frontend.identity" || \
      die 'staged frontend identity changed after initial validation'
    rm -f -- "$transaction_dir/frontend.identity.new"
  else
    mv -Tf -- "$transaction_dir/frontend.identity.new" "$transaction_dir/frontend.identity"
  fi
}

while (($#)); do
  case $1 in
    --backend) (($# >= 2)) || die '--backend requires go or rs'; BACKEND=$2; shift 2 ;;
    --frontend-only) FRONTEND_ONLY=1; shift ;;
    --host) (($# >= 2)) || die '--host requires a target host'; TARGET_HOST=$2; shift 2 ;;
    --deployment-id) (($# >= 2)) || die '--deployment-id requires a value'; DEPLOYMENT_ID=$2; shift 2 ;;
    --controller) (($# >= 2)) || die '--controller requires local or ArchDmit'; CONTROLLER=$2; shift 2 ;;
    --jump-host) (($# >= 2)) || die '--jump-host requires archczy'; JUMP_HOST=$2; shift 2 ;;
    --ssh-config) (($# >= 2)) || die '--ssh-config requires a path'; SSH_CONFIG=$2; shift 2 ;;
    --remote-inspect) REMOTE_INSPECT=1; shift ;;
    --route-gate) (($# >= 2)) || die '--route-gate requires a path'; ROUTE_GATE=$2; shift 2 ;;
    --confirm) (($# >= 2)) || die '--confirm requires api.lmm.best'; CONFIRM=$2; shift 2 ;;
    --workspace) (($# >= 2)) || die '--workspace requires a path'; WORKSPACE=$2; shift 2 ;;
    --target-backup) (($# >= 2)) || die '--target-backup requires a marker path'; TARGET_BACKUP=$2; shift 2 ;;
    --controller-backup) (($# >= 2)) || die '--controller-backup requires a marker path'; CONTROLLER_BACKUP=$2; shift 2 ;;
    --offhost-backup) (($# >= 2)) || die '--offhost-backup requires a marker path'; OFFHOST_BACKUP=$2; shift 2 ;;
    --core-package) (($# >= 2)) || die '--core-package requires a package path'; CORE_PACKAGE=$2; shift 2 ;;
    --backend-package) (($# >= 2)) || die '--backend-package requires a package path'; BACKEND_PACKAGE=$2; shift 2 ;;
    --execute-cleanup) EXECUTE_CLEANUP=1; shift ;;
    --execute-remote) EXECUTE_REMOTE=1; shift ;;
    --create-backups) CREATE_BACKUPS=1; shift ;;
    --age-recipient-file) (($# >= 2)) || die '--age-recipient-file requires a path'; AGE_RECIPIENT_FILE=$2; shift 2 ;;
    preflight|inspect|build|package|backup|watchdog|switch|confirm|rollback|cleanup)
      ((PHASE_SET == 0)) || die 'deployment phase may only be specified once'
      PHASE=$1; PHASE_SET=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

if ((FRONTEND_ONLY)); then
  [[ -z $BACKEND ]] || die '--frontend-only cannot be combined with --backend'
  [[ -z $BACKEND_PACKAGE ]] || die '--frontend-only cannot be combined with --backend-package'
  [[ -z $ROUTE_GATE ]] || die '--frontend-only cannot be combined with --route-gate'
  [[ -z ${LMM_ACCEPTANCE_CREDENTIAL_FILE:-} && -z ${LMM_ACCEPTANCE_CREDENTIAL_FD:-} ]] || \
    die '--frontend-only does not accept backend acceptance credentials'
  BACKEND='go'
else
  [[ $BACKEND == go || $BACKEND == rs ]] || die '--backend is required and must be go or rs'
fi
[[ $TARGET_HOST == "$EXPECTED_HOST" ]] || die "unsupported target host/role: expected --host $EXPECTED_HOST"
[[ $CONTROLLER == local ]] || die "unsupported controller role: expected --controller local"
[[ -z $JUMP_HOST || $JUMP_HOST == archczy ]] || die 'unsupported jump host: expected archczy'
[[ $CONFIRM == '' || $CONFIRM == "$EXPECTED_CONFIRMATION" ]] || \
  die "exact confirmation must be $EXPECTED_CONFIRMATION"
is_safe_path "$WORKSPACE" || die 'workspace must be an absolute, non-traversing path'
if ((EXECUTE_REMOTE == 1 && !FRONTEND_ONLY)) && [[ $PHASE == switch ]]; then
  [[ -n ${LMM_ACCEPTANCE_CREDENTIAL_FILE:-} && -z ${LMM_ACCEPTANCE_CREDENTIAL_FD:-} ]] || \
    die 'remote acceptance requires LMM_ACCEPTANCE_CREDENTIAL_FILE; inherited credential FDs cannot cross SSH'
  is_safe_remote_credential_path "$LMM_ACCEPTANCE_CREDENTIAL_FILE" || \
    die 'remote acceptance credential file path is unsafe'
fi

detect_execution_context
validate_installed_cli_context

transaction_id=$DEPLOYMENT_ID
[[ $transaction_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die 'invalid transaction id'
transaction_dir="$WORKSPACE/$transaction_id"
marker="$transaction_dir/$MARKER_NAME"
state_file="$transaction_dir/$STATE_FILE_NAME"

ensure_workspace() {
  mkdir -p -- "$transaction_dir"
  if [[ -e $marker || -L $marker ]]; then
    [[ -f $marker && ! -L $marker ]] || die 'workspace marker is not a regular file'
    grep -Fqx "deployment_id=$transaction_id" "$marker" || die 'workspace marker transaction mismatch'
    grep -Fqx 'role=controller' "$marker" || die 'workspace marker role mismatch'
    grep -Fqx "workspace=$transaction_dir" "$marker" || die 'workspace marker path mismatch'
  else
    printf 'format=1\ndeployment_id=%s\nrole=controller\nworkspace=%s\ncreated_at_utc=%s\n' \
      "$transaction_id" "$transaction_dir" "$(date -u +%FT%TZ)" >"$marker"
    chmod 0600 "$marker"
  fi
}

read_state() { [[ -f $state_file && ! -L $state_file ]] && sed -n '1p' "$state_file" || printf 'NEW\n'; }
transition_state() {
  local expected=$1 replacement=$2 current temporary="$state_file.$$.tmp"
  current=$(read_state)
  [[ $current == "$expected" ]] || die "illegal state transition: $current -> $replacement (expected $expected)"
  printf '%s\n' "$replacement" >"$temporary"
  chmod 0600 "$temporary"
  mv -Tf -- "$temporary" "$state_file"
}
phase_should_run() {
  local expected=$1 completed=$2 current
  current=$(read_state)
  case $current in
    "$expected") return 0 ;;
    "$completed") log "phase already complete: $completed"; return 1 ;;
    *) die "phase requires exact state $expected; current state is $current" ;;
  esac
}

validate_ssh_transport() {
  local owner mode
  is_safe_path "$SSH_CONFIG" || die 'SSH config path is unsafe'
  [[ -f $SSH_CONFIG && ! -L $SSH_CONFIG ]] || die 'SSH config must be a regular non-symlink file'
  owner=$(stat -c '%u' "$SSH_CONFIG")
  mode=$(stat -c '%a' "$SSH_CONFIG")
  [[ $owner == "$EUID" ]] || die 'SSH config is not owned by the controller user'
  (( (8#$mode & 8#022) == 0 )) || die 'SSH config is group/other writable'
  grep -Eiq '^[[:space:]]*Host[[:space:]]+([^#]*[[:space:]])?archczy([[:space:]]|$)' "$SSH_CONFIG" || \
    die 'SSH config does not define the archczy jump alias'
  for command in ssh scp; do command -v "$command" >/dev/null 2>&1 || die "required controller command is unavailable: $command"; done
}

verify_backup_copy() {
  local copy_role=$1 directory=$2 manifest="$2/manifest.env" filename
  [[ -d $directory && ! -L $directory && -f $manifest && ! -L $manifest && \
    -f $directory/SHA256SUMS && ! -L $directory/SHA256SUMS ]] || \
    die "backup copy is incomplete: $copy_role"
  grep -Fqx "copy_role=$copy_role" "$manifest" || die "backup copy role mismatch: $copy_role"
  grep -Fqx 'deployment_role=production' "$manifest" || die 'backup deployment role mismatch'
  grep -Fqx "deployment_id=$transaction_id" "$manifest" || die 'backup deployment identity mismatch'
  grep -Fqx 'verified_host=arch-dmit' "$manifest" || die 'backup host identity mismatch'
  grep -Fqx 'database_engine=postgres' "$manifest" || die 'backup database identity mismatch'
  if [[ $copy_role == target ]]; then
    grep -Fqx 'configuration_encrypted=false' "$manifest" || die 'target configuration backup encryption marker is invalid'
    grep -Fqx 'database_encrypted=false' "$manifest" || die 'target database backup encryption marker is invalid'
  else
    grep -Fqx 'configuration_encrypted=true' "$manifest" || die "$copy_role configuration backup is not encrypted"
    grep -Fqx 'database_encrypted=true' "$manifest" || die "$copy_role database backup is not encrypted"
  fi
  (cd "$directory" && sha256sum -c SHA256SUMS >/dev/null) || die "backup checksum verification failed: $copy_role"
  for filename in application.archive frontend.archive; do
    [[ -s $directory/$filename && -f $directory/$filename && ! -L $directory/$filename ]] || \
      die "backup archive is missing: $copy_role/$filename"
  done
  if [[ $copy_role == target ]]; then
    for filename in configuration.archive database.archive; do
      [[ -s $directory/$filename && -f $directory/$filename && ! -L $directory/$filename ]] || \
        die "backup archive is missing: $copy_role/$filename"
    done
  else
    for filename in configuration.age database.age; do
      [[ -s $directory/$filename && -f $directory/$filename && ! -L $directory/$filename ]] || \
        die "backup archive is missing: $copy_role/$filename"
    done
  fi
}

verify_backup_set() {
  local verify_target=${1:-$TARGET_BACKUP}
  local verify_controller=${2:-$CONTROLLER_BACKUP}
  local verify_offhost=${3:-$OFFHOST_BACKUP}
  local expected_revision core_sha backend_sha frontend_digest manifest
  validate_authoritative_backup_paths
  for path in "$verify_target" "$verify_controller" "$verify_offhost"; do
    [[ -n $path ]] || die 'production backup verification requires target, controller, and off-host copies'
    is_safe_path "$path" || die 'backup-set path is unsafe'
    [[ -d $path && ! -L $path ]] || die 'backup-set path is missing or symlinked'
  done
  [[ $verify_target != "$verify_controller" && $verify_target != "$verify_offhost" && \
    $verify_controller != "$verify_offhost" ]] || die 'backup-set copies must use distinct directories'
  verify_backup_copy target "$verify_target"
  verify_backup_copy controller "$verify_controller"
  verify_backup_copy off-host "$verify_offhost"
  expected_revision=$(resolve_revision)
  core_sha=$(sha256sum "$transaction_dir/core.pkg" | awk '{print $1}')
  if (( FRONTEND_ONLY )); then
    [[ -f $transaction_dir/frontend.identity && ! -L $transaction_dir/frontend.identity ]] || \
      die 'frontend identity marker is missing'
    frontend_digest=$(sed -n 's/^frontend_digest=//p' "$transaction_dir/frontend.identity")
    is_sha256 "$frontend_digest" || die 'frontend digest marker is invalid'
    backend_sha=$(sed -n 's/^backend_sha256=//p' "$verify_target/manifest.env")
    is_sha256 "$backend_sha" || die 'frontend-only backup does not identify the current Go backend'
    core_sha=$(sha256sum "$transaction_dir/core.pkg" | awk '{print $1}')
    for manifest in "$verify_target/manifest.env" "$verify_controller/manifest.env" "$verify_offhost/manifest.env"; do
      for fact in "verified_host=arch-dmit" "database_engine=postgres" "release_id=$transaction_id" \
        "git_revision=$expected_revision" "artifact_sha256=$frontend_digest" "core_sha256=$core_sha" \
        "backend_sha256=$backend_sha"; do
        grep -Fqx "$fact" "$manifest" || die "backup identity mismatch: $fact"
      done
    done
    return 0
  fi
  backend_sha=$(sha256sum "$transaction_dir/backend.pkg" | awk '{print $1}')
  for manifest in "$verify_target/manifest.env" "$verify_controller/manifest.env" "$verify_offhost/manifest.env"; do
    for fact in "verified_host=arch-dmit" "database_engine=postgres" "release_id=$transaction_id" \
      "git_revision=$expected_revision" "core_sha256=$core_sha" "backend_sha256=$backend_sha"; do
      grep -Fqx "$fact" "$manifest" || die "backup identity mismatch: $fact"
    done
  done
}

validate_authoritative_backup_paths() {
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 0 )); then
    [[ $TARGET_BACKUP == "/var/lib/lmm-api/deploy-backups/$transaction_id" ]] || die 'target backup root is not authoritative'
    [[ $CONTROLLER_BACKUP == "$HOME/backup/lmm-api/arch-dmit/$transaction_id" ]] || die 'controller backup root is not authoritative'
    [[ $OFFHOST_BACKUP == "/var/backups/lmm-api/$transaction_id" ]] || die 'off-host backup root is not authoritative'
  fi
}

validate_route_gate() {
  local actual_gate_sha asset_manifest asset_manifest_sha checker expected_gate_sha expected_revision snapshot_dir
  local authenticated_manifest authenticated_validator authentication_dir expected_validator_sha
  local frozen_contract installed_frozen installed_gate installed_migration installed_validator migration_compatibility
  local repo_frozen repo_gate repo_migration repo_root repo_validator validator
  repo_root=$SOURCE_REPO_ROOT
  repo_gate="$repo_root/apps/api-rust/tests/fixtures/routes/migration-gate.tsv"
  repo_validator="$repo_root/packaging/common/lmm-api/validate-route-gate"
  repo_migration="$repo_root/packaging/common/lmm-api/migration-compatibility.env"
  repo_frozen="$repo_root/apps/api-rust/tests/fixtures/routes/frozen-route-auth.tsv"
  installed_gate="${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}/migration-gate.tsv"
  installed_validator="${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}/validate-route-gate"
  installed_migration="${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}/migration-compatibility.env"
  installed_frozen="${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}/frozen-route-auth.tsv"
  if [[ -z $ROUTE_GATE ]]; then
    [[ -f $installed_gate ]] && ROUTE_GATE=$installed_gate || ROUTE_GATE=$repo_gate
  fi
  is_safe_path "$ROUTE_GATE" || die 'Rust route gate path is unsafe'
  [[ $ROUTE_GATE == "$repo_gate" || $ROUTE_GATE == "$installed_gate" ]] || \
    die 'Rust route gate must be the canonical repository or installed migration-gate.tsv'
  [[ -f $ROUTE_GATE && ! -L $ROUTE_GATE ]] || die 'Rust route gate is missing or symlinked'
  if [[ $ROUTE_GATE == "$repo_gate" ]]; then
    validator=$repo_validator
    migration_compatibility=$repo_migration
    frozen_contract=$repo_frozen
    expected_gate_sha=$(git -C "$repo_root" show HEAD:apps/api-rust/tests/fixtures/routes/migration-gate.tsv | sha256sum | awk '{print $1}') || \
      die 'cannot bind migration gate to the current Git revision'
    asset_manifest="$transaction_dir/source-route-gate-assets.sha256"
    {
      printf '%s  migration-gate.tsv\n' "$(sha256sum "$repo_gate" | awk '{print $1}')"
      printf '%s  validate-route-gate\n' "$(sha256sum "$repo_validator" | awk '{print $1}')"
      printf '%s  migration-compatibility.env\n' "$(sha256sum "$repo_migration" | awk '{print $1}')"
      printf '%s  frozen-route-auth.tsv\n' "$(sha256sum "$repo_frozen" | awk '{print $1}')"
    } >"$asset_manifest.new"
    chmod 0600 "$asset_manifest.new"
    mv -Tf -- "$asset_manifest.new" "$asset_manifest"
    asset_manifest_sha=$(sha256sum "$asset_manifest" | awk '{print $1}')
  else
    validator=$installed_validator
    migration_compatibility=$installed_migration
    frozen_contract=$installed_frozen
    asset_manifest="${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}/route-gate-assets.sha256"
    [[ -f $asset_manifest && ! -L $asset_manifest ]] || die 'installed route-gate asset manifest is missing'
    awk '
      NF != 2 || $1 !~ /^[0-9a-f]{64}$/ { failed=1; next }
      $2 !~ /^(migration-gate.tsv|validate-route-gate|migration-compatibility.env|frozen-route-auth.tsv)$/ { failed=1 }
      { if (seen[$2]++) failed=1 }
      END { if (NR != 4 || length(seen) != 4) failed=1; exit failed }
    ' "$asset_manifest" || die 'installed route-gate asset manifest is invalid'
    (cd -- "${LMM_API_DEPLOY_LIBDIR:-/usr/lib/lmm-api/deploy}" && \
      sha256sum -c route-gate-assets.sha256 >/dev/null) || die 'installed route-gate asset checksum mismatch'
    expected_gate_sha=$(awk '$2 == "migration-gate.tsv" { print $1 }' "$asset_manifest")
    asset_manifest_sha=$(sha256sum "$asset_manifest" | awk '{print $1}')
  fi
  [[ -x $validator && ! -L $validator ]] || die 'canonical route-gate validator is missing or unsafe'
  is_sha256 "$expected_gate_sha" || die 'authoritative migration gate checksum is invalid'
  actual_gate_sha=$(sha256sum "$ROUTE_GATE" | awk '{print $1}')
  [[ $actual_gate_sha == "$expected_gate_sha" ]] || die 'Rust route gate checksum mismatch'
  expected_revision=$(resolve_revision)
  if [[ $ROUTE_GATE == "$installed_gate" ]]; then
    authentication_dir=$(mktemp -d "$transaction_dir/route-validator-auth.XXXXXXXX")
    authenticated_manifest="$authentication_dir/route-gate-assets.sha256"
    cp --no-dereference --preserve=mode,ownership -- "$asset_manifest" "$authenticated_manifest" || \
      die 'installed route-gate manifest authentication copy failed'
    [[ -f $authenticated_manifest && ! -L $authenticated_manifest && \
      $(sha256sum "$authenticated_manifest" | awk '{print $1}') == "$asset_manifest_sha" ]] || \
      die 'installed route-gate manifest changed after package authentication'
    expected_validator_sha=$(awk '$2 == "validate-route-gate" { print $1 }' "$authenticated_manifest")
    is_sha256 "$expected_validator_sha" || die 'installed validator checksum is invalid'
    authenticated_validator="$authentication_dir/validate-route-gate"
    cp --no-dereference --preserve=mode,ownership -- "$validator" "$authenticated_validator" || \
      die 'installed validator authentication copy failed'
    [[ -f $authenticated_validator && ! -L $authenticated_validator && \
      $(sha256sum "$authenticated_validator" | awk '{print $1}') == "$expected_validator_sha" ]] || \
      die 'installed validator changed after package authentication'
    chmod 0500 "$authenticated_validator"
    validator=$authenticated_validator
    asset_manifest=$authenticated_manifest
  fi
  snapshot_dir=$(mktemp -d "$transaction_dir/route-gate-snapshot.XXXXXXXX")
  LMM_ROUTE_GATE_TEST_MODE=${LMM_DEPLOY_TEST_MODE:-0} \
    "$validator" --mode activate --snapshot-dir "$snapshot_dir" \
    --assets-manifest "$asset_manifest" --assets-manifest-sha256 "$asset_manifest_sha" \
    --gate "$ROUTE_GATE" --frozen-contract "$frozen_contract" \
    --evidence-root "$(dirname -- "$migration_compatibility")" --revision "$expected_revision" \
    --migration-compatibility "$migration_compatibility" || \
    { rm -rf -- "$snapshot_dir" "${authentication_dir:-}"; die 'Rust production routing gate rejected the route or migration evidence'; }
  rm -rf -- "$snapshot_dir" "${authentication_dir:-}"
  checker="$repo_root/apps/api-rust/tests/scripts/check-migration-plan.sh"
  if [[ -x $checker && ${LMM_DEPLOY_TEST_MODE:-0} == 0 ]]; then
    MIGRATION_GATE_PATH="$ROUTE_GATE" "$checker" >/dev/null || die 'authoritative migration checker rejected the route gate'
  fi
}

remote_inspect() {
  local output observed_host
  [[ $JUMP_HOST == archczy ]] || die 'remote production inspection requires --jump-host archczy'
  validate_ssh_transport
  observed_host=$(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" \
    "$PRODUCTION_SSH_TARGET" hostnamectl --static) || die 'could not observe remote static hostname'
  [[ $observed_host == arch-dmit ]] || die 'remote production host identity mismatch'
  output=$(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" \
    "$PRODUCTION_SSH_TARGET" bash -s <<'EOF'
set -Eeuo pipefail
env_file=/etc/lmm-api/lmm-api.env
backend_config=/etc/lmm-api/backend.conf
[[ -f $env_file && ! -L $env_file && -f $backend_config && ! -L $backend_config ]]
count=0
while IFS= read -r line || [[ -n $line ]]; do
  [[ $line =~ ^[[:space:]]*(SQL_DSN|DATABASE_URL)[[:space:]]*=(postgres|postgresql):// ]] || continue
  ((count += 1))
done <"$env_file"
((count == 1))
selection=$(sed -nE 's/^LMM_API_BACKEND=(go|rs)$/\1/p' "$backend_config")
[[ $selection == go || $selection == rs ]]
case $selection in
  go) backend_path=/usr/lib/lmm-api/backends/go/lmm-api ;;
  rs) backend_path=/usr/lib/lmm-api/backends/rs/lmm-api-rs ;;
esac
[[ -f $backend_path && ! -L $backend_path ]]
owner=$(LC_ALL=C pacman -Qqo -- "$backend_path")
case "$selection:$owner" in
  go:lmm-api-go|go:lmm-api-go-bin|go:lmm-api-go-git|rs:lmm-api-rs|rs:lmm-api-rs-bin|rs:lmm-api-rs-git) ;;
  *) exit 3 ;;
esac
LC_ALL=C pacman -Qkk "$owner" >/dev/null
systemctl is-active --quiet lmm-api.service
frontend=$(readlink -- /srv/lmm-api-frontend/current)
[[ $frontend =~ ^releases/[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]]
printf 'role=production\nobserved_host=arch-dmit\nexpected_host=arch-dmit\nhost_match=true\n'
printf 'db_engine=postgres\nbackend_selection=%s\nbackend_package=%s\nfrontend_release=%s\nservice_state=active\n' \
  "$selection" "$(LC_ALL=C pacman -Q "$owner")" "${frontend#releases/}"
EOF
  ) || die 'remote sanitized inspection failed'
  grep -Fqx 'host_match=true' <<<"$output" || die 'remote production host identity mismatch'
  grep -Fqx 'db_engine=postgres' <<<"$output" || die 'remote database engine disagrees with PostgreSQL production contract'
  if grep -Eiq '(password|token|secret|dsn)=' <<<"$output"; then
    die 'sanitized inspection emitted a forbidden secret-bearing key'
  fi
  printf '%s\n' "$output" >"$transaction_dir/inspect.kv"
  chmod 0600 "$transaction_dir/inspect.kv"
}

build_aur_packages() {
  local script_dir repo_root package_dir
  script_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
  repo_root=$(cd -- "$script_dir/../../.." && pwd -P)
  package_dir=lmm-api-bin
  (( FRONTEND_ONLY )) && package_dir=lmm-api-git
  [[ -d $repo_root/.git && -f $repo_root/packaging/aur/$package_dir/PKGBUILD ]] || \
    die 'build is controller-source-only; the installed CLI cannot build AUR packages'
  if (( ! FRONTEND_ONLY )); then
    [[ -f $repo_root/packaging/aur/lmm-api-rs-bin/PKGBUILD ]] || \
      die 'Rust provider PKGBUILD is missing'
  fi
  (( ${LMM_DEPLOY_TEST_MODE:-0} == 0 )) || return 0
  for command in makepkg sha256sum; do
    command -v "$command" >/dev/null 2>&1 || die "required build command is unavailable: $command"
  done
  mkdir -p "$transaction_dir/artifacts" "$transaction_dir/cache/src" \
    "$transaction_dir/cache/build" "$transaction_dir/logs" "$transaction_dir/manifests"
  local -a package_dirs=(lmm-api-bin)
  if (( FRONTEND_ONLY )); then package_dirs=(lmm-api-git); else package_dirs+=(lmm-api-rs-bin); fi
  for package_dir in "${package_dirs[@]}"; do
    (
      cd -- "$repo_root/packaging/aur/$package_dir"
      env PKGDEST="$transaction_dir/artifacts" SRCDEST="$transaction_dir/cache/src" \
        BUILDDIR="$transaction_dir/cache/build/$package_dir" LOGDEST="$transaction_dir/logs" \
        makepkg --cleanbuild --syncdeps --noconfirm
    ) || die "AUR build failed: $package_dir"
  done
  mapfile -t built_packages < <(find "$transaction_dir/artifacts" -maxdepth 1 -type f \
    \( -name 'lmm-api-bin-*.pkg.tar.*' -o -name 'lmm-api-git-*.pkg.tar.*' -o -name 'lmm-api-rs-bin-*.pkg.tar.*' \) ! -name '*.sig' | sort)
  if (( FRONTEND_ONLY )); then
    ((${#built_packages[@]} == 1)) || die 'frontend-only build did not produce exactly one core package'
    [[ ${built_packages[0]##*/} == lmm-api-git-*.pkg.tar.* ]] || die 'frontend-only build did not produce exact lmm-api-git'
  else
    ((${#built_packages[@]} == 2)) || die 'build did not produce exactly core and Rust provider packages'
  fi
  sha256sum "${built_packages[@]}" >"$transaction_dir/manifests/packages.SHA256SUMS"
}

