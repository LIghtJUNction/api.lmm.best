remote_run_frontend_activator() {
  local mode=$1 target_backup=$2 core_sha=$3 revision=$4 frontend_digest=$5 release_id=$6
  local remote_transaction remote_root status
  local -a encoded ssh_cmd values
  [[ $mode == prepare || $mode == switch || $mode == confirm ]] || die 'invalid frontend activator mode'
  remote_transaction=$(remote_transaction_root)
  remote_root="$remote_transaction/staging"
  status="$remote_root/status"
  values=(
    "$remote_transaction" "$remote_transaction/state/rollback.guard" "$target_backup"
    "$remote_root/core.pkg" "$core_sha" "$release_id" "$revision" "$status"
    "$frontend_digest" "$remote_root/frontend-activator"
  )
  for value in "${values[@]}"; do encoded+=("$(encode_remote_value "$value")"); done
  ssh_cmd=(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  "${ssh_cmd[@]}" bash -s -- "$mode" "${encoded[@]}" <<'EOF'
set -Eeuo pipefail
mode=$1
shift
decode() { printf '%s' "$1" | base64 --decode; }
workspace=$(decode "$1"); guard=$(decode "$2"); target_backup=$(decode "$3")
core_package=$(decode "$4"); core_sha=$(decode "$5"); release=$(decode "$6")
revision=$(decode "$7"); status=$(decode "$8"); frontend_digest=$(decode "$9")
activator=$(decode "${10}")
common=(--workspace "$workspace" --guard "$guard" --target-backup "$target_backup" \
  --core-package "$core_package" --core-sha256 "$core_sha" \
  --expected-release "$release" --expected-revision "$revision" \
  --status-file "$status" --frontend-digest "$frontend_digest")
case $mode in
  prepare|switch|confirm) "$activator" "$mode" "${common[@]}" ;;
  *) exit 64 ;;
esac
EOF
}

execute_remote_frontend_switch() {
  local activator core_sha revision frontend_digest release_id remote_transaction remote_root status target_backup remote_status
  local -a ssh_cmd scp_cmd
  ((EXECUTE_REMOTE == 1)) || return 0
  [[ -n $JUMP_HOST && $JUMP_HOST == archczy ]] || die 'frontend remote switch requires --jump-host archczy'
  validate_ssh_transport
  activator="$transaction_dir/frontend-activator"
  [[ -x $activator && ! -L $activator ]] || die 'embedded frontend activator is unavailable'
  [[ -f $transaction_dir/core.pkg && -f $transaction_dir/frontend.identity ]] || die 'staged frontend package is missing'
  core_sha=$(sha256sum "$transaction_dir/core.pkg" | awk '{print $1}')
  frontend_digest=$(sed -n 's/^frontend_digest=//p' "$transaction_dir/frontend.identity")
  release_id=$(sed -n 's/^frontend_release=//p' "$transaction_dir/frontend.identity")
  [[ $release_id =~ ^[0-9a-fA-F]{7,64}$ ]] || die 'frontend package release identity is invalid'
  revision=$(resolve_revision)
  target_backup=${TARGET_BACKUP:-/var/lib/lmm-api/deploy-backups/$transaction_id}
  remote_transaction=$(remote_transaction_root)
  remote_root="$remote_transaction/staging"
  status="$remote_root/status"
  ssh_cmd=(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  scp_cmd=(scp -F "$SSH_CONFIG" -o "ProxyJump=$JUMP_HOST" -P "$PRODUCTION_SSH_PORT")
  "${ssh_cmd[@]}" install -d -m0700 "$remote_root" "$remote_transaction/state"
  "${ssh_cmd[@]}" bash -s -- "$(encode_remote_value "$transaction_id")" "$(encode_remote_value "$remote_transaction")" <<'EOF'
set -Eeuo pipefail
decode() { printf '%s' "$1" | base64 --decode; }
deployment_id=$(decode "$1")
workspace=$(decode "$2")
printf 'format=1\ndeployment_id=%s\nrole=target\nworkspace=%s\ncreated_at_utc=%s\n' \
  "$deployment_id" "$workspace" "$(date -u +%FT%TZ)" >"$workspace/.lmm-deploy-workspace"
chmod 0600 "$workspace/.lmm-deploy-workspace"
EOF
  "${scp_cmd[@]}" "$transaction_dir/core.pkg" "$activator" \
    "$PRODUCTION_SSH_TARGET:$remote_root/"
  remote_run_frontend_activator prepare "$target_backup" "$core_sha" "$revision" "$frontend_digest" "$release_id"
  remote_run_frontend_activator switch "$target_backup" "$core_sha" "$revision" "$frontend_digest" "$release_id"
  remote_status=$("${ssh_cmd[@]}" cat -- "$status")
  [[ $remote_status == AWAITING_CONFIRMATION\ * ]] || \
    die "target frontend activation did not await confirmation: $remote_status"
}

remote_frontend_confirm() {
  local core_sha revision frontend_digest release_id target_backup remote_status remote_root
  local -a ssh_cmd
  ((EXECUTE_REMOTE == 1)) || return 0
  [[ -n $JUMP_HOST && $JUMP_HOST == archczy ]] || die 'frontend confirmation requires --jump-host archczy'
  validate_ssh_transport
  ssh_cmd=(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  core_sha=$(sha256sum "$transaction_dir/core.pkg" | awk '{print $1}')
  frontend_digest=$(sed -n 's/^frontend_digest=//p' "$transaction_dir/frontend.identity")
  release_id=$(sed -n 's/^frontend_release=//p' "$transaction_dir/frontend.identity")
  [[ $release_id =~ ^[0-9a-fA-F]{7,64}$ ]] || die 'frontend package release identity is invalid'
  revision=$(resolve_revision)
  target_backup=${TARGET_BACKUP:-/var/lib/lmm-api/deploy-backups/$transaction_id}
  remote_run_frontend_activator confirm "$target_backup" "$core_sha" "$revision" "$frontend_digest" "$release_id"
  remote_root="$(remote_transaction_root)/staging"
  remote_status=$("${ssh_cmd[@]}" cat -- "$remote_root/status")
