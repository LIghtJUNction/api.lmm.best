inspect_remote_go_identity() {
  local observed output backend_sha
  local -a ssh_cmd
  if (( ${LMM_DEPLOY_TEST_MODE:-0} == 1 )) && [[ -n ${LMM_DEPLOY_TEST_FRONTEND_BACKEND_SHA256:-} ]]; then
    is_sha256 "$LMM_DEPLOY_TEST_FRONTEND_BACKEND_SHA256" || die 'test Go backend checksum is invalid'
    printf '%s\n' "$LMM_DEPLOY_TEST_FRONTEND_BACKEND_SHA256"
    return
  fi
  [[ $JUMP_HOST == archczy ]] || die 'Go backend identity inspection requires --jump-host archczy'
  validate_ssh_transport
  ssh_cmd=(ssh -F "$SSH_CONFIG" -J "$JUMP_HOST" -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  observed=$("${ssh_cmd[@]}" hostnamectl --static) || die 'could not observe remote static hostname'
  [[ $observed == arch-dmit ]] || die 'remote production host identity mismatch'
  output=$("${ssh_cmd[@]}" bash -s <<'EOF'
set -Eeuo pipefail
backend_config=/etc/lmm-api/backend.conf
backend_path=/usr/lib/lmm-api/backends/go/lmm-api
service=lmm-api.service
[[ -f $backend_config && ! -L $backend_config && -f $backend_path && ! -L $backend_path ]]
[[ $(sed -nE 's/^LMM_API_BACKEND=(go|rs)$/\1/p' "$backend_config") == go ]]
owner=$(LC_ALL=C pacman -Qqo -- "$backend_path")
case $owner in lmm-api-go|lmm-api-go-bin|lmm-api-go-git) ;; *) exit 3 ;; esac
record=$(LC_ALL=C pacman -Q "$owner")
[[ $record == "$owner "* && ${record#* } != *[[:space:]]* ]]
LC_ALL=C pacman -Qkk "$owner" >/dev/null
systemctl is-active --quiet "$service"
printf 'backend_package=%s\nbackend_sha256=%s\nbackend_pid=%s\n' \
  "$record" "$(sha256sum "$backend_path" | awk '{print $1}')" \
  "$(systemctl show --property=MainPID --value "$service")"
EOF
) || die 'remote current Go backend identity verification failed'
  grep -Eq '^backend_package=lmm-api-go(-bin|-git)? [^[:space:]]+$' <<<"$output" || \
    die 'remote Go provider package identity is invalid'
  backend_sha=$(sed -n 's/^backend_sha256=//p' <<<"$output")
  is_sha256 "$backend_sha" || die 'remote Go backend checksum is invalid'
  grep -Eq '^backend_pid=[1-9][0-9]*$' <<<"$output" || die 'remote Go backend process identity is invalid'
  printf '%s\n' "$output" >"$transaction_dir/remote-go.identity"
  chmod 0600 "$transaction_dir/remote-go.identity"
  printf '%s\n' "$backend_sha"
}

create_and_promote_backups_builtin() {
  local revision artifact_sha core_sha backend_sha current_backend_sha remote_transaction remote_root
  local remote_target remote_controller remote_offhost remote_recipient remote_output
  local offhost_mirror recipient_mode recipient_owner
  local -a target_ssh target_scp offhost_ssh

  [[ -n $JUMP_HOST && $JUMP_HOST == archczy ]] || \
    die 'backup creation requires --jump-host archczy'
  [[ -n $AGE_RECIPIENT_FILE && -f $AGE_RECIPIENT_FILE && ! -L $AGE_RECIPIENT_FILE ]] || \
    die 'backup creation requires --age-recipient-file'
  recipient_mode=$(stat -c '%a' "$AGE_RECIPIENT_FILE")
  recipient_owner=$(stat -c '%u' "$AGE_RECIPIENT_FILE")
  [[ $recipient_owner == "$EUID" ]] || die 'age recipient file is not controller-owned'
  (( (8#$recipient_mode & 8#022) == 0 )) || \
    die 'age recipient file is group/other writable'
  if (( FRONTEND_ONLY )); then
    [[ -f $transaction_dir/frontend.identity && ! -L $transaction_dir/frontend.identity ]] || \
      die 'backup creation requires the staged frontend identity'
  else
    [[ -f $transaction_dir/package.identity && ! -L $transaction_dir/package.identity && \
      -f $transaction_dir/backend.pkg && ! -L $transaction_dir/backend.pkg ]] || \
      die 'backup creation requires staged backend package identity'
  fi

  TARGET_BACKUP=${TARGET_BACKUP:-/var/lib/lmm-api/deploy-backups/$transaction_id}
  CONTROLLER_BACKUP=${CONTROLLER_BACKUP:-$HOME/backup/lmm-api/arch-dmit/$transaction_id}
  OFFHOST_BACKUP=${OFFHOST_BACKUP:-/var/backups/lmm-api/$transaction_id}
  validate_authoritative_backup_paths
  is_safe_path "$CONTROLLER_BACKUP" || die 'controller backup output path is unsafe'
  is_safe_path "$OFFHOST_BACKUP" || die 'off-host backup output path is unsafe'
  [[ ! -e $CONTROLLER_BACKUP && ! -L $CONTROLLER_BACKUP ]] || \
    die 'controller backup output already exists'
  install -d -m0700 -- "${CONTROLLER_BACKUP%/*}"

  revision=$(resolve_revision)
  core_sha=$(sha256sum "$transaction_dir/core.pkg" | awk '{print $1}')
  current_backend_sha=$(inspect_remote_go_identity)
  is_sha256 "$current_backend_sha" || die 'current Go backend checksum is invalid'
  if (( FRONTEND_ONLY )); then
    artifact_sha=$(sed -n 's/^frontend_digest=//p' "$transaction_dir/frontend.identity")
    backend_sha=$current_backend_sha
    is_sha256 "$artifact_sha" || die 'frontend digest marker is invalid'
  else
    artifact_sha=$(sha256sum "$transaction_dir/backend.pkg" | awk '{print $1}')
    backend_sha=$artifact_sha
  fi

  remote_transaction=$(remote_transaction_root)
  remote_root="$remote_transaction/staging"
  remote_target=$TARGET_BACKUP
  remote_controller="$remote_root/controller-copy"
  remote_offhost="$remote_root/offhost-copy"
  remote_recipient="$remote_root/age-recipient"
  offhost_mirror="$transaction_dir/staging/backup-off-host"

  FRONTEND_BACKUP_ACTIVE=1
  FRONTEND_BACKUP_REMOTE_TRANSACTION=$remote_transaction
  FRONTEND_BACKUP_TARGET_OUTPUT=$remote_target
  FRONTEND_BACKUP_CONTROLLER_REMOTE=$remote_controller
  FRONTEND_BACKUP_OFFHOST_REMOTE=$remote_offhost
  FRONTEND_BACKUP_CONTROLLER_OUTPUT=$CONTROLLER_BACKUP
  FRONTEND_BACKUP_OFFHOST_OUTPUT=$OFFHOST_BACKUP
  FRONTEND_BACKUP_OFFHOST_MIRROR=$offhost_mirror
  FRONTEND_BACKUP_SSH_CONFIG=$SSH_CONFIG
  FRONTEND_BACKUP_JUMP_HOST=$JUMP_HOST
  FRONTEND_BACKUP_SSH_BIN=${LMM_DEPLOY_SSH_BIN:-ssh}
  FRONTEND_BACKUP_SCP_BIN=${LMM_DEPLOY_SCP_BIN:-scp}
  trap cleanup_frontend_backup_transaction ERR EXIT

  target_ssh=("$FRONTEND_BACKUP_SSH_BIN" -F "$SSH_CONFIG" -J "$JUMP_HOST" \
    -p "$PRODUCTION_SSH_PORT" "$PRODUCTION_SSH_TARGET")
  target_scp=("$FRONTEND_BACKUP_SCP_BIN" -F "$SSH_CONFIG" -o "ProxyJump=$JUMP_HOST" \
    -P "$PRODUCTION_SSH_PORT")
  offhost_ssh=("$FRONTEND_BACKUP_SSH_BIN" -F "$SSH_CONFIG" "$JUMP_HOST")

  "${target_ssh[@]}" bash -s -- \
    "$(encode_remote_value "$remote_transaction")" \
    "$(encode_remote_value "$remote_target")" \
    "$(encode_remote_value "$remote_controller")" \
    "$(encode_remote_value "$remote_offhost")" <<'EOF'
set -Eeuo pipefail
decode() { printf '%s' "$1" | base64 --decode; }
for encoded in "$@"; do
  path=$(decode "$encoded")
  [[ ! -e $path && ! -L $path ]] || exit 3
done
EOF
  "${offhost_ssh[@]}" test ! -e "$OFFHOST_BACKUP"
  [[ ! -e $offhost_mirror && ! -L $offhost_mirror ]] || \
    die 'off-host backup mirror already exists'

  "${target_ssh[@]}" install -d -m0700 "$remote_root"
  FRONTEND_BACKUP_REMOTE_TRANSACTION_OWNED=1
  FRONTEND_BACKUP_TARGET_OUTPUT_OWNED=1
  FRONTEND_BACKUP_CONTROLLER_REMOTE_OWNED=1
  FRONTEND_BACKUP_OFFHOST_REMOTE_OWNED=1
  FRONTEND_BACKUP_LOCK_CREATED=1
  "${target_scp[@]}" "$AGE_RECIPIENT_FILE" "$PRODUCTION_SSH_TARGET:$remote_recipient"
  "${target_ssh[@]}" chmod 0600 "$remote_recipient"

  remote_output=$("${target_ssh[@]}" bash -s -- \
    "$(encode_remote_value "$transaction_id")" \
    "$(encode_remote_value "$remote_transaction")" \
    "$(encode_remote_value "$remote_target")" \
    "$(encode_remote_value "$remote_controller")" \
    "$(encode_remote_value "$remote_offhost")" \
    "$(encode_remote_value "$remote_recipient")" \
    "$(encode_remote_value "$artifact_sha")" \
    "$(encode_remote_value "$core_sha")" \
    "$(encode_remote_value "$backend_sha")" \
    "$(encode_remote_value "$current_backend_sha")" \
    "$(encode_remote_value "$revision")" <<'EOF'
set -Eeuo pipefail
umask 077
decode() { printf '%s' "$1" | base64 --decode; }
id=$(decode "$1"); workspace=$(decode "$2"); target=$(decode "$3")
controller=$(decode "$4"); offhost=$(decode "$5"); recipient=$(decode "$6")
artifact_sha=$(decode "$7"); core_sha=$(decode "$8"); expected_backend_sha=$(decode "$9")
expected_current_backend_sha=$(decode "${10}"); revision=$(decode "${11}")
[[ $EUID -eq 0 ]] || exit 2
[[ $(hostnamectl --static) == arch-dmit ]] || exit 2
[[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || exit 2
[[ $workspace == /var/lib/lmm-api/deploy-work/$id ]] || exit 2
[[ $target == /var/lib/lmm-api/deploy-backups/$id ]] || exit 2
[[ $controller == "$workspace/staging/controller-copy" ]] || exit 2
[[ $offhost == "$workspace/staging/offhost-copy" ]] || exit 2
[[ $recipient == "$workspace/staging/age-recipient" ]] || exit 2
[[ $artifact_sha =~ ^[0-9a-f]{64}$ && $core_sha =~ ^[0-9a-f]{64}$ ]] || exit 2
[[ $expected_backend_sha =~ ^[0-9a-f]{64}$ && $expected_current_backend_sha =~ ^[0-9a-f]{64}$ ]] || exit 2
[[ $revision =~ ^[0-9a-fA-F]{7,64}$ ]] || exit 2
for command in age awk chmod date grep hostnamectl install mkdir mv pacman pg_dump \
  pg_restore readlink rm rmdir sed sha256sum stat systemctl tar; do
