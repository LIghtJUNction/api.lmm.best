remote_frontend_rollback() {
  local unit remote_status
  local -a ssh_cmd
  ((EXECUTE_REMOTE == 1)) || die 'rollback requires --execute-remote'
  [[ -n $JUMP_HOST && $JUMP_HOST == archczy ]] || die 'frontend rollback requires --jump-host archczy'
  validate_ssh_transport
  unit="lmm-api-frontend-rollback-${transaction_id}.service"
