  FRONTEND_BACKUP_OFFHOST_OUTPUT_OWNED=1
  "${FRONTEND_BACKUP_SCP_BIN}" -F "$SSH_CONFIG" -r \
    "$offhost_mirror/." "$JUMP_HOST:$OFFHOST_BACKUP/"
  "${offhost_ssh[@]}" bash -s -- "$(encode_remote_value "$OFFHOST_BACKUP")" <<'EOF'
set -Eeuo pipefail
decode() { printf '%s' "$1" | base64 --decode; }
output=$(decode "$1")
[[ -d $output && ! -L $output && -f $output/manifest.env && -f $output/SHA256SUMS ]]
(cd "$output" && sha256sum -c SHA256SUMS >/dev/null)
grep -Fqx 'copy_role=off-host' "$output/manifest.env"
grep -Fqx 'deployment_role=production' "$output/manifest.env"
EOF
  "${target_ssh[@]}" bash -s -- \
    "$(encode_remote_value "$remote_target")" \
    "$(encode_remote_value "$transaction_id")" \
    "$(encode_remote_value "$revision")" \
    "$(encode_remote_value "$artifact_sha")" \
    "$(encode_remote_value "$core_sha")" \
    "$(encode_remote_value "$backend_sha")" <<'EOF'
set -Eeuo pipefail
decode() { printf '%s' "$1" | base64 --decode; }
target=$(decode "$1"); id=$(decode "$2"); revision=$(decode "$3")
artifact_sha=$(decode "$4"); core_sha=$(decode "$5"); backend_sha=$(decode "$6")
[[ $target == "/var/lib/lmm-api/deploy-backups/$id" && -d $target && ! -L $target ]]
(cd "$target" && sha256sum -c SHA256SUMS >/dev/null)
for fact in 'copy_role=target' 'deployment_role=production' 'verified_host=arch-dmit' \
  "deployment_id=$id" "release_id=$id" 'database_engine=postgres' \
  'configuration_encrypted=false' 'database_encrypted=false' \
  "git_revision=$revision" "artifact_sha256=$artifact_sha" \
  "core_sha256=$core_sha" "backend_sha256=$backend_sha"; do
  grep -Fqx "$fact" "$target/manifest.env"
done
EOF
  for manifest in "$CONTROLLER_BACKUP/manifest.env" "$offhost_mirror/manifest.env"; do
    for fact in "deployment_id=$transaction_id" 'verified_host=arch-dmit' \
      'database_engine=postgres' "release_id=$transaction_id" "git_revision=$revision" \
      "artifact_sha256=$artifact_sha" "core_sha256=$core_sha" "backend_sha256=$backend_sha"; do
      grep -Fqx "$fact" "$manifest" || die "backup identity mismatch: $fact"
    done
  done

  "${target_ssh[@]}" rm -rf -- "$remote_controller" "$remote_offhost" "$remote_transaction"
  FRONTEND_BACKUP_SUCCEEDED=1
  FRONTEND_BACKUP_LOCK_CREATED=0
  trap - ERR EXIT
  printf 'target=%s\ncontroller=%s\noffhost=%s\ncreated_and_verified=true\n' \
    "$TARGET_BACKUP" "$CONTROLLER_BACKUP" "$OFFHOST_BACKUP" \
    >"$transaction_dir/backups.verified"
  chmod 0600 "$transaction_dir/backups.verified"
}

create_and_promote_backups() { create_and_promote_backups_builtin; }

preflight() {
  local command
  [[ $PHASE == preflight || $PHASE == inspect || $PHASE == build || $PHASE == package || $PHASE == backup || $PHASE == watchdog || $PHASE == switch || $PHASE == confirm || $PHASE == rollback || $PHASE == cleanup ]] || return
  for command in awk base64 chmod cmp date grep install mkdir mv readlink sed sha256sum stat; do
    command -v "$command" >/dev/null 2>&1 || die "required controller command is unavailable: $command"
  done
  case $PHASE in
    package|backup|watchdog|switch) for command in bsdtar pacman; do command -v "$command" >/dev/null 2>&1 || die "required controller command is unavailable: $command"; done ;;
  esac
  if ((REMOTE_INSPECT || EXECUTE_REMOTE || CREATE_BACKUPS)); then
    validate_ssh_transport
  fi
  if (( ! FRONTEND_ONLY )) && [[ $BACKEND == rs && $PHASE != rollback && $PHASE != cleanup ]]; then
    ensure_workspace
    validate_route_gate
  fi
  log "preflight ok: backend=$BACKEND target=$TARGET_HOST controller=$CONTROLLER jump=${JUMP_HOST:-none}"
}

case $PHASE in
  preflight)
    preflight
    ;;
  inspect)
    preflight; ensure_workspace
    phase_should_run NEW INSPECTED || exit 0
    ((REMOTE_INSPECT == 0)) || remote_inspect
    transition_state NEW INSPECTED
    log "inspection recorded: $transaction_dir"
    ;;
  build)
    preflight; ensure_workspace
    phase_should_run INSPECTED BUILT || exit 0
    build_aur_packages
    transition_state INSPECTED BUILT
    if (( FRONTEND_ONLY )); then
      log 'AUR core build completed once in the controller workspace for frontend-only publishing'
    else
      log 'AUR core and Rust provider build completed once in the controller workspace'
    fi
    ;;
  package)
    preflight; ensure_workspace
    phase_should_run BUILT PACKAGED || exit 0
    [[ -n $CORE_PACKAGE ]] || die 'package requires --core-package AUR artifact'
    if (( ! FRONTEND_ONLY )); then
      [[ $BACKEND == rs ]] || die 'production package phase requires --backend rs'
      [[ -n $BACKEND_PACKAGE ]] || die 'package requires --backend-package AUR artifact'
    fi
    package_inputs=("$CORE_PACKAGE")
    (( FRONTEND_ONLY )) || package_inputs+=("$BACKEND_PACKAGE")
    for artifact in "${package_inputs[@]}"; do
      is_safe_path "$artifact" || die 'package artifact path is unsafe'
      [[ -f $artifact && ! -L $artifact ]] || die 'package artifact must be an absolute regular non-symlink file'
    done
    if (( ! FRONTEND_ONLY )); then
      [[ $(realpath -e -- "$CORE_PACKAGE") != "$(realpath -e -- "$BACKEND_PACKAGE")" ]] || \
        die 'core and provider package paths must be distinct'
    fi
    core_name=${CORE_PACKAGE##*/}
    if (( FRONTEND_ONLY )); then
      [[ $core_name == lmm-api-git-*.pkg.tar.* || $core_name == lmm-api-bin-*.pkg.tar.* ]] || \
        die 'frontend-only core package must be exact lmm-api-git or lmm-api-bin'
    else
      [[ $core_name == lmm-api-bin-*.pkg.tar.* ]] || die 'production core package must be lmm-api-bin'
    fi
    [[ $core_name != *.sig ]] || die 'production core package cannot be a signature sidecar'
    if (( ! FRONTEND_ONLY )); then
      backend_name=${BACKEND_PACKAGE##*/}
      [[ $backend_name == lmm-api-rs-bin-*.pkg.tar.* && $backend_name != *.sig ]] || \
        die 'production backend package must be exact lmm-api-rs-bin'
    fi
    install -m0600 -- "$CORE_PACKAGE" "$transaction_dir/core.pkg"
    if (( FRONTEND_ONLY )); then
      validate_frontend_artifact
      sha256sum "$transaction_dir/core.pkg" >"$transaction_dir/SHA256SUMS"
    else
      install -m0600 -- "$BACKEND_PACKAGE" "$transaction_dir/backend.pkg"
      validate_staged_artifacts
      sha256sum "$transaction_dir/core.pkg" "$transaction_dir/backend.pkg" >"$transaction_dir/SHA256SUMS"
    fi
    chmod 0600 "$transaction_dir/SHA256SUMS"
    transition_state BUILT PACKAGED
    log 'package staged with checksum marker'
    ;;
  backup)
    preflight; ensure_workspace
    phase_should_run PACKAGED BACKUP_VERIFIED || exit 0
    if (( FRONTEND_ONLY )); then validate_frontend_artifact; else validate_staged_artifacts; fi
    if ((CREATE_BACKUPS)); then
      create_and_promote_backups
    else
      verify_backup_set
      printf 'target=%s\ncontroller=%s\noffhost=%s\n' "$TARGET_BACKUP" "$CONTROLLER_BACKUP" "$OFFHOST_BACKUP" >"$transaction_dir/backups.verified"
      chmod 0600 "$transaction_dir/backups.verified"
    fi
    transition_state PACKAGED BACKUP_VERIFIED
    log 'target/controller/off-host backups verified'
    ;;
  watchdog)
    preflight; ensure_workspace
    phase_should_run BACKUP_VERIFIED WATCHDOG_READY || exit 0
    if (( FRONTEND_ONLY )); then
      validate_frontend_artifact
      write_embedded_frontend_activator
      printf 'state=prepared\ntimeout_seconds=600\ndeployment_id=%s\nmode=frontend-only\n' \
        "$transaction_id" >"$transaction_dir/watchdog"
    else
      validate_staged_artifacts
      write_embedded_backend_runtime
      printf 'state=prepared\ntimeout_seconds=600\ndeployment_id=%s\n' \
        "$transaction_id" >"$transaction_dir/watchdog"
    fi
    chmod 0600 "$transaction_dir/watchdog"
    if (( ! FRONTEND_ONLY )); then cat >"$transaction_dir/lmm-api-rollback.service" <<EOF
[Unit]
Description=LMM API rollback for $transaction_id
After=network-online.target

[Service]
Type=oneshot
Environment=LMM_API_DEPLOY_TRANSACTION=$transaction_id
ExecCondition=/usr/bin/grep -Eq ^status=(ARMED|ROLLING_BACK)$ __LMM_GUARD__
ExecStart=__LMM_CLI__ deploy internal watchdog --deployment-id __LMM_DEPLOYMENT_ID__
EOF
    cat >"$transaction_dir/lmm-api-rollback.timer" <<'EOF'
[Unit]
Description=LMM API 600-second rollback watchdog

[Timer]
OnCalendar=@__LMM_ROLLBACK_DEADLINE_EPOCH__
Persistent=true
AccuracySec=1s
Unit=lmm-api-rollback.service

[Install]
WantedBy=timers.target
EOF
    fi
    chmod 0600 "$transaction_dir/watchdog"
    if (( ! FRONTEND_ONLY )); then chmod 0600 "$transaction_dir/lmm-api-rollback.service" "$transaction_dir/lmm-api-rollback.timer"; fi
    transition_state BACKUP_VERIFIED WATCHDOG_READY
    log 'watchdog gate ready'
    ;;
  switch)
    preflight; ensure_workspace
    phase_should_run WATCHDOG_READY AWAITING_CONFIRMATION || exit 0
    if (( FRONTEND_ONLY )); then validate_frontend_artifact; else validate_staged_artifacts; fi
    execute_remote_switch
    if ((EXECUTE_REMOTE)); then
      printf 'target=arch-dmit\ndeployment_id=%s\n' "$transaction_id" >"$transaction_dir/remote-switched"
      chmod 0600 "$transaction_dir/remote-switched"
    fi
    transition_state WATCHDOG_READY AWAITING_CONFIRMATION
    log 'AWAITING_CONFIRMATION: operator must run confirm with --confirm api.lmm.best'
    ;;
  confirm)
    preflight; ensure_workspace
    phase_should_run AWAITING_CONFIRMATION CONFIRMED || exit 0
    [[ $CONFIRM == "$EXPECTED_CONFIRMATION" ]] || die "exact confirmation must be $EXPECTED_CONFIRMATION"
    [[ -f $transaction_dir/remote-switched ]] || die 'confirmation requires a real remote-switched transaction'
    ((EXECUTE_REMOTE == 1)) || die 'confirmation of a switched transaction requires --execute-remote'
    remote_confirm
    transition_state AWAITING_CONFIRMATION CONFIRMED
    log 'deployment transaction confirmed'
    ;;
  rollback)
    ensure_workspace
    case $(read_state) in
      WATCHDOG_READY) rollback_from=WATCHDOG_READY ;;
      AWAITING_CONFIRMATION) rollback_from=AWAITING_CONFIRMATION ;;
      ROLLED_BACK) log 'rollback already recorded'; exit 0 ;;
      *) die 'rollback requires exact WATCHDOG_READY or AWAITING_CONFIRMATION state' ;;
    esac
    remote_rollback
    transition_state "$rollback_from" ROLLED_BACK
    log 'rollback recorded; database restore was not attempted'
    ;;
  cleanup)
    ensure_workspace
    case $(read_state) in CONFIRMED|ROLLED_BACK) ;; *) die 'cleanup requires CONFIRMED or ROLLED_BACK state' ;; esac
    if ((EXECUTE_CLEANUP == 0)); then
      log "cleanup preview: $transaction_dir"
      exit 0
    fi
    [[ -f $marker && ! -L $marker ]] || die 'cleanup marker is missing or unsafe'
    [[ $(realpath -e -- "$transaction_dir") == "$transaction_dir" ]] || die 'cleanup workspace is not canonical'
    rm -rf -- "$transaction_dir"
    log 'marker-owned deployment workspace removed'
    ;;
esac
exit 0

