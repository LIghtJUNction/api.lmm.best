die() { printf 'activate-rust-release: %s\n' "$*" >&2; exit 1; }
is_sha256() { [[ ${1:-} =~ ^[0-9a-f]{64}$ ]]; }
safe_identity() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]]; }
validate_test_installed_cli() {
  local path=$1 mode
  [[ $path =~ ^/[A-Za-z0-9._/+:-]+$ && $path != *'//'* && -f $path && -x $path && ! -L $path ]] ||
    die 'test installed CLI path is unsafe'
