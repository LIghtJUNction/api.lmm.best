+	return DB.Table("open_source_bounty_disputes AS d").
+		Select(`d.*, d.project_title_snapshot AS project_title, d.repository_url_snapshot AS repository_url, c.status AS challenge_status,
+			p.escrow_quota AS current_project_escrow_quota,
+			d.issue_url_snapshot AS issue_url, d.pull_request_url_snapshot AS pull_request_url,
+			d.encrypted_review_message_snapshot AS encrypted_review_message, d.review_note_snapshot AS review_note,
+			d.reward_quota_snapshot AS reward_quota, d.tip_quota_snapshot AS tip_quota,
+			d.owner_rating_score_snapshot AS owner_rating_score, d.owner_rating_comment_snapshot AS owner_rating_comment,
+			d.contributor_rating_score_snapshot AS contributor_rating_score, d.contributor_rating_comment_snapshot AS contributor_rating_comment,
+			owner.username AS owner_username, participant.username AS participant_username,
+			opener.username AS opened_by_username, against_user.username AS against_username`).
