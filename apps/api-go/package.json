{
  "name": "@lmm/api-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "go run .",
    "run": "./out/lmm-api",
    "build": "sh -c 'mkdir -p out && CGO_ENABLED=0 go build -trimpath -ldflags=\"-s -w\" -o out/lmm-api .'",
    "test": "go test ./...",
    "typecheck": "go test -run '^$' ./...",
    "lint": "go vet ./...",
    "format": "go fmt ./...",
    "format:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
