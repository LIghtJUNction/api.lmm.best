# Copy to .env and populate complete connection URLs. Secrets are intentionally blank: Compose
# and `make start-api` fail closed until an operator supplies them.
#
# DATABASE_URL must target PostgreSQL 18 and set this exact versioned search path in URL-encoded
# options: options=-csearch_path%3Dlmm_app_v1%2Cpg_catalog
# Use a runtime role whose default privileges are limited to this application schema.
DATABASE_URL=
VALKEY_URL=

# lmm-db-migrate uses a separate privileged URL and the same schema identifier via --schema.
# It is not consumed by the API container and must never be substituted for DATABASE_URL.
LMM_MIGRATE_DATABASE_URL=
LMM_DATABASE_SCHEMA=lmm_app_v1
LMM_SCHEMA_CONTRACT=1

# Required lmm-api-rs process configuration for a direct `make start-api` launch.
LMM_RS_LISTEN_ADDR=127.0.0.1:3000
LMM_RS_SLOT=blue
LMM_WEB_DIST_DIR=./web/dist

# Explicit operational defaults accepted by lmm-api-rs.
LMM_DEPENDENCY_TIMEOUT_SECONDS=2
LMM_DRAIN_TIMEOUT_SECONDS=30
LMM_PUBLIC_CONTENT_CACHE_TTL_SECONDS=5
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=360
GLOBAL_API_RATE_LIMIT_DURATION=180

# Container publishing and build identity.
LMM_API_BIND_ADDRESS=127.0.0.1
LMM_API_PORT=3000
LMM_BUILD_REVISION=development
TZ=Asia/Shanghai
