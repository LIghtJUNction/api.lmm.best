# Test-only credentials for /etc/lmm-api-rs-single/common.env (mode 0600).
# This file is intentionally separate from the production blue/green template.
# The Rust binary refuses to start the single-instance service unless the
# database, database role, and schema each start with `lmm_test_`, and unless
# Valkey is loopback port 6380. The single service always binds 127.0.0.1:3100.
DATABASE_URL=postgres://lmm_test_runtime:REPLACE_ME@127.0.0.1/lmm_test_runtime?options=-csearch_path%3Dlmm_test_runtime_v1
VALKEY_URL=redis://:REPLACE_ME@127.0.0.1:6380/0
# Supply separate high-entropy values, each at least 32 non-whitespace bytes.
# Do not leave either checked-in placeholder in the runtime environment.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CRYPTO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
LMM_SCHEMA_CONTRACT=1
LMM_DEPENDENCY_TIMEOUT_SECONDS=2
LMM_DRAIN_TIMEOUT_SECONDS=30
AUTH_COOKIE_SECURE=true
AUTH_TRUSTED_ORIGINS=https://fallback.lmm.best
# The isolated test site must keep the normal username/password sign-in path
# available so its authenticated dashboard routes can be exercised.
PASSWORD_LOGIN_ENABLED=true
LMM_PUBLIC_CONTENT_CACHE_TTL_SECONDS=5
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=360
GLOBAL_API_RATE_LIMIT_DURATION=180
TRUSTED_PROXIES=127.0.0.1
