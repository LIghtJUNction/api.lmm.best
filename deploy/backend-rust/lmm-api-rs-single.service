[Unit]
Description=LMM API Rust backend (isolated test single instance)
After=network-online.target postgresql.service valkey-lmm-api.service
Wants=network-online.target

[Service]
Type=simple
User=lmm-api-rs-fallback
Group=lmm-api-rs-fallback
# This unit is deliberately separate from lmm-api-rs@.service. It is only for
# fallback.lmm.best test validation and must never share production config.
Environment=LMM_RS_TEST_INSTANCE=1
EnvironmentFile=/etc/lmm-api-rs-single/common.env
# Keep the slot and listener in the unit itself.  The legacy single.env is
# retained as a checked-in bootstrap asset but is intentionally not consumed:
# systemd EnvironmentFile entries override Environment= values.
Environment=LMM_RS_SLOT=single
Environment=LMM_RS_LISTEN_ADDR=127.0.0.1:3100
ExecStart=/opt/lmm-api-rs-single/current/lmm-api-rs
Restart=on-failure
RestartSec=2s
TimeoutStopSec=45s
TimeoutAbortSec=45s
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/lmm-api-rs-single
UMask=0077
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
