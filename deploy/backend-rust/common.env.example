# Install as /etc/lmm-api-rs/common.env with mode 0600.
# Never commit real credentials.
# Keep every Rust slot on the same versioned application schema.  The migration
# contract rejects the shared `public` schema; replace `lmm_prod_v1` only as an
# explicit, reviewed schema-contract release.
DATABASE_URL=postgres://lmm_api:REPLACE_ME@127.0.0.1/lmm_api?options=-csearch_path%3Dlmm_prod_v1
VALKEY_URL=redis://:REPLACE_ME@127.0.0.1:6380/0
# A distinct high-entropy value (at least 32 non-whitespace bytes). It is also
# the temporary CRYPTO_SECRET fallback until a dedicated secret is configured.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
LMM_SCHEMA_CONTRACT=1
LMM_DEPENDENCY_TIMEOUT_SECONDS=2
LMM_DRAIN_TIMEOUT_SECONDS=30
# Legacy-compatible dashboard cookie settings. AUTH_COOKIE_SECURE and
# AUTH_TRUSTED_ORIGINS, when set, take precedence. Secure cookies require one
# or more exact HTTPS origins; local HTTP must set secure=false and no origins.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://panel.example.com
# Strictly validated: only 1..=5 seconds are accepted; invalid values stop the
# Rust slot before it can receive traffic.
LMM_PUBLIC_CONTENT_CACHE_TTL_SECONDS=5
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=360
GLOBAL_API_RATE_LIMIT_DURATION=180
# Blank/unset preserves Go compatibility (loopback, RFC1918, IPv6 ULA proxies).
# Set `none` to ignore forwarded headers, or a comma-separated exact IP/CIDR
# list to replace the compatibility defaults.
TRUSTED_PROXIES=127.0.0.1
# Do not persist LMM_RS_CUTOVER_APPROVAL here. It is a one-shot environment
# approval for an explicitly authorized internal-probe rehearsal only.
