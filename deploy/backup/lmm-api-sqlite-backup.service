[Unit]
Description=LMM API SQLite online backup to archczy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/lmm-api/sqlite-backup.env
LoadCredential=archczy-backup.identity:/etc/lmm-api/credentials/archczy-backup.identity
LoadCredential=archczy-backup.known_hosts:/etc/lmm-api/credentials/archczy-backup.known_hosts
ExecStart=/usr/local/lib/lmm-api/backup-sqlite-to-archczy.sh
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/run/lock
