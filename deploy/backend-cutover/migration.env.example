# Install as /etc/lmm-api-cutover/migration.env with mode 0600 root:root.
# The migration role should be the future application role so it owns the
# versioned schema and can run compatible GORM expand migrations after cutover.
LMM_MIGRATE_DATABASE_URL=postgresql://lmm_api:REPLACE_ME@127.0.0.1/lmm_api
