[Unit]
Description=Reconcile interrupted lmm-api database cutover before API startup
DefaultDependencies=no
After=local-fs.target
Before=lmm-api.service

[Service]
Type=oneshot
ExecStart=/usr/lib/lmm-api-cutover/cutover-sqlite-to-pg.sh --reconcile-only --prepare-start
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
