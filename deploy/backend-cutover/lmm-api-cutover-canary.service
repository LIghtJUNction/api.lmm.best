[Unit]
Description=Complete lmm-api cutover reconciliation canaries after API startup
After=lmm-api-cutover-reconcile.service lmm-api.service
Requires=lmm-api-cutover-reconcile.service
Wants=lmm-api.service
ConditionPathExists=/var/lib/lmm-api-cutover/cutover-journal

[Service]
Type=oneshot
ExecStart=/usr/lib/lmm-api-cutover/cutover-sqlite-to-pg.sh --reconcile-only

[Install]
WantedBy=multi-user.target
