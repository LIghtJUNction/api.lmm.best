{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LMM legacy route behavior fixture",
  "type": "object",
  "required": ["schema_version", "source", "route", "request", "response", "effects", "normalization"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["revision", "synthetic"],
      "properties": {
        "revision": { "const": "5418ce6b6d45ed69167b0aad53f2f595e5bc8de9" },
        "synthetic": { "const": true }
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "middleware", "side_effects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "middleware": { "type": "array", "items": { "type": "string" } },
        "side_effects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "request": {
      "type": "object",
      "required": ["method", "path", "headers", "body"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "headers": { "type": "object" },
        "body": {}
      }
    },
    "response": {
      "type": "object",
      "required": ["status", "selected_headers", "body", "sse_frames"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "selected_headers": { "type": "object" },
        "body": {},
        "sse_frames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "effects": {
      "type": "object",
      "required": ["database", "valkey"],
      "properties": {
        "database": {
          "type": "object",
          "required": ["inserted", "updated", "deleted"],
          "properties": {
            "inserted": { "type": "array" },
            "updated": { "type": "array" },
            "deleted": { "type": "array" }
          }
        },
        "valkey": {
          "type": "object",
          "required": ["added", "changed", "removed"],
          "properties": {
            "added": { "type": "array" },
            "changed": { "type": "array" },
            "removed": { "type": "array" }
          }
        }
      }
    },
    "normalization": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "operation", "replacement", "reason"],
            "properties": {
              "path": { "type": "string", "pattern": "^\\$\\." },
              "operation": { "enum": ["replace", "regex_replace"] },
              "pattern": { "type": "string" },
              "replacement": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
