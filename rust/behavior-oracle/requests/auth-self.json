{
  "route": { "id": "GET /api/user/self", "middleware": ["RouteTag(api)", "gzip", "BodyStorageCleanup", "GlobalAPIRateLimit", "UserAuth"], "side_effects": [] },
  "request": { "method": "GET", "path": "/api/user/self", "headers": { "accept": "application/json" }, "body": null },
  "observe": { "db_tables": ["users", "user_sessions"], "valkey_patterns": ["*"] },
  "capture_headers": ["content-type", "x-new-api-version", "x-oneapi-request-id"],
  "normalization": { "rules": [
    { "path": "$.response.selected_headers.x-oneapi-request-id", "operation": "replace", "replacement": "<REQUEST_ID>", "reason": "legacy request ids contain wall-clock time and randomness" }
  ] }
}
