{
  "route": { "id": "POST /v1/chat/completions", "middleware": ["CORS", "DecompressRequest", "BodyStorageCleanup", "Stats", "RouteTag(relay)", "SystemPerformanceCheck", "TokenAuth", "ModelRequestRateLimit", "Distribute"], "side_effects": [] },
  "request": { "method": "POST", "path": "/v1/chat/completions", "headers": { "accept": "application/json", "content-type": "application/json" }, "body": { "model": "oracle-model", "messages": [{ "role": "user", "content": "hello" }] } },
  "observe": { "db_tables": ["tokens", "logs"], "valkey_patterns": ["*"] },
  "capture_headers": ["content-type", "x-new-api-version", "x-oneapi-request-id"],
  "normalization": { "rules": [
    { "path": "$.response.selected_headers.x-oneapi-request-id", "operation": "replace", "replacement": "<REQUEST_ID>", "reason": "legacy request ids contain wall-clock time and randomness" },
    { "path": "$.response.body.error.message", "operation": "regex_replace", "pattern": "request id: [^)]+", "replacement": "request id: <REQUEST_ID>", "reason": "relay errors embed the generated request id" }
  ] }
}
